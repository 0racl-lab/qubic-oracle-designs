+#!/usr/bin/env python3
+"""Minimal mock dogecoind / bitcoind JSON-RPC node for the read_utxo_tx oracle service selftest.
+
+Answers getrawtransaction (verbose) and getblockheader the way Dogecoin Core / Bitcoin Core do,
+including JSON-RPC errors sent with HTTP 500 and HTTP basic auth (user "qubic", password "om").
+Amounts are written as JSON decimals with 8 places, exactly as the node prints them.
+
+--tamper   changes one output by 1 koinu (provider disagreement)
+--lag N    reports every confirmation count N lower (a node a few blocks behind)
+
+Usage: mock_utxo_node.py --port 18745 [--tamper] [--lag 3]
+"""
+
+import argparse
+import base64
+import json
+from http.server import BaseHTTPRequestHandler, HTTPServer
+
+AUTH = "Basic " + base64.b64encode(b"qubic:om").decode()
+
+TIP = 5_400_000
+BLOCK_A = "a1" * 32    # buried: 50 confirmations
+BLOCK_S = "a2" * 32    # shallow: 5 confirmations
+BLOCK_O = "a3" * 32    # reorganised away: confirmations -1
+HEADERS = {
+    BLOCK_A: {"height": TIP - 49, "time": 1764000000},
+    BLOCK_S: {"height": TIP - 4, "time": 1764002700},
+    BLOCK_O: {"height": TIP - 20, "time": 1764001500, "orphan": True},
+}
+
+# Dogecoin P2PKH: OP_DUP OP_HASH160 <20 bytes> OP_EQUALVERIFY OP_CHECKSIG
+P2PKH_SELLER = "76a914" + "5e" * 20 + "88ac"
+P2PKH_CHANGE = "76a914" + "c4" * 20 + "88ac"
+# OP_RETURN carrying a 32-byte trade reference
+OP_RETURN_REF = "6a20" + "7a" * 32
+BIG_SCRIPT = "51" * 200  # a 200-byte script (non-standard, but valid in a block)
+
+TXID_A = "d0" * 31 + "01"   # confirmed, 3 outputs
+TXID_M = "d0" * 31 + "02"   # mempool
+TXID_S = "d0" * 31 + "03"   # shallow
+TXID_O = "d0" * 31 + "04"   # in an orphaned block
+TXID_B = "d0" * 31 + "05"   # confirmed, oversized script
+TXID_F = "d0" * 31 + "06"   # confirmed, amount with 9 decimals (impossible: node bug)
+
+
+def amount(text):
+    return {"__raw__": text}
+
+
+def tx(txid, outputs, block=None, tamper=False):
+    vout = []
+    for n, (value, script) in enumerate(outputs):
+        if tamper and n == 0:
+            value = value[:-1] + str((int(value[-1]) + 1) % 10)
+        vout.append({"value": amount(value), "n": n, "scriptPubKey": {"hex": script, "type": "x"}})
+    out = {"txid": txid, "hash": txid, "version": 1, "vin": [], "vout": vout}
+    if block:
+        out["blockhash"] = block
+    return out
+
+
+def transactions(tamper):
+    return {
+        TXID_A: tx(TXID_A, [("1234.56789012", P2PKH_SELLER), ("0.00000000", OP_RETURN_REF),
+                            ("98765.43210000", P2PKH_CHANGE)], BLOCK_A, tamper),
+        TXID_M: tx(TXID_M, [("10.00000000", P2PKH_SELLER)]),
+        TXID_S: tx(TXID_S, [("10.00000000", P2PKH_SELLER)], BLOCK_S),
+        TXID_O: tx(TXID_O, [("10.00000000", P2PKH_SELLER)], BLOCK_O),
+        TXID_B: tx(TXID_B, [("1.00000000", BIG_SCRIPT)], BLOCK_A),
+        TXID_F: tx(TXID_F, [("1.000000001", P2PKH_SELLER)], BLOCK_A),
+    }
+
+
+def encode(obj):
+    """JSON with raw decimal amounts (so 0.1 stays 0.1, as the node prints it)."""
+    text, out, marker = json.dumps(obj), [], '{"__raw__": "'
+    while marker in text:
+        before, rest = text.split(marker, 1)
+        number, text = rest.split('"}', 1)
+        out.append(before + number)
+    out.append(text)
+    return "".join(out)
+
+
+class Handler(BaseHTTPRequestHandler):
+    tamper = False
+    lag = 0
+
+    def log_message(self, fmt, *args):  # quiet
+        pass
+
+    def reply(self, status, obj):
+        body = encode(obj).encode()
+        self.send_response(status)
+        self.send_header("Content-Type", "application/json")
+        self.send_header("Content-Length", str(len(body)))
+        self.end_headers()
+        self.wfile.write(body)
+
+    def do_POST(self):
+        if self.headers.get("Authorization") != AUTH:
+            self.send_response(401)
+            self.end_headers()
+            return
+        length = int(self.headers.get("Content-Length", 0))
+        request = json.loads(self.rfile.read(length))
+        method, params, rid = request.get("method"), request.get("params", []), request.get("id")
+
+        if method == "getrawtransaction":
+            found = transactions(self.tamper).get(params[0])
+            if params[1:] != [1]:
+                return self.reply(500, {"result": None, "error": {"code": -8, "message": "expected verbose=1"}, "id": rid})
+            if found is None:
+                return self.reply(500, {"result": None, "error": {
+                    "code": -5, "message": "No such mempool or blockchain transaction. Use gettransaction for wallet transactions."}, "id": rid})
+            if "blockhash" in found:
+                h = HEADERS[found["blockhash"]]
+                found["confirmations"] = -1 if h.get("orphan") else TIP - h["height"] + 1 - self.lag
+            return self.reply(200, {"result": found, "error": None, "id": rid})
+
+        if method == "getblockheader":
+            h = HEADERS.get(params[0])
+            if h is None:
+                return self.reply(500, {"result": None, "error": {"code": -5, "message": "Block not found"}, "id": rid})
+            confirmations = -1 if h.get("orphan") else TIP - h["height"] + 1 - self.lag
+            return self.reply(200, {"result": {"hash": params[0], "confirmations": confirmations, "height": h["height"],
+                                               "time": h["time"], "version": 6422788}, "error": None, "id": rid})
+
+        return self.reply(500, {"result": None, "error": {"code": -32601, "message": "Method not found"}, "id": rid})
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--port", type=int, required=True)
+    parser.add_argument("--tamper", action="store_true")
+    parser.add_argument("--lag", type=int, default=0)
+    args = parser.parse_args()
+    Handler.tamper, Handler.lag = args.tamper, args.lag
+    HTTPServer(("127.0.0.1", args.port), Handler).serve_forever()
+
+
+if __name__ == "__main__":
+    main()
