+#!/usr/bin/env python3
+"""Run one real UtxoTxRead query through the service logic against your own node(s).
+
+    UTXO_RPC_URLS_DOGECOIN=http://user:pass@127.0.0.1:22555 \
+    python3 test/live_check.py dogecoin <txid> <vout> [--confirmations 10]
+
+Prints the decoded reply. Nothing is sent to Qubic.
+"""
+
+import argparse
+import os
+import struct
+import sys
+import urllib.request
+
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), ".."))
+import read_utxo_tx_service as svc
+
+IDS = {name.lower(): network_id for network_id, (name, _) in svc.NETWORKS.items()}
+NAMES = {0: "SUCCESS", 1: "BAD_QUERY", 2: "NETWORK_UNSUPPORTED", 3: "TX_NOT_FOUND",
+         4: "NOT_CONFIRMED", 5: "OUTPUT_OUT_OF_RANGE", 6: "SCRIPT_TOO_LARGE"}
+
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("network", choices=sorted(IDS))
+    p.add_argument("txid")
+    p.add_argument("vout", type=int)
+    p.add_argument("--confirmations", type=int, help="default: the network's minimum")
+    a = p.parse_args()
+    urllib.request.install_opener(urllib.request.build_opener(urllib.request.ProxyHandler({})))
+    network = IDS[a.network]
+    min_conf = a.confirmations or svc.NETWORKS[network][1]
+    payload = struct.pack("<Q32sQQ", network, bytes.fromhex(a.txid), a.vout, min_conf)
+    flags, r = svc.handle_query(svc.load_networks(), payload)
+    if flags:
+        print(f"abstained (flags {flags:#x}): see the message above")
+        return 2
+    code = struct.unpack("<Q", r[:8])[0]
+    print(f"code {code} {NAMES.get(code, '?')}")
+    if code == 0:
+        height, time, count, value, slen = struct.unpack("<QQQQQ", r[40:80])
+        print(f"block {r[8:40].hex()} height {height} time {time}")
+        print(f"output {a.vout} of {count}: {value} base units ({value / 1e8:.8f} coins), script {r[80:80 + slen].hex()}")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
