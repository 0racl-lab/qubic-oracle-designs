index 0000000..3c1b07b
--- /dev/null
+++ b/oracles/read_utxo_tx/read_utxo_tx_service.py
@@ -0,0 +1,325 @@
+#!/usr/bin/env python3
+"""read_utxo_tx oracle service (interface index 6): one output of a confirmed Dogecoin / Bitcoin /
+Litecoin transaction.
+
+Query 56B:  network u64 | txid 32B (display order) | outputIndex u64 | minConfirmations u64.
+Reply 208B: code u64 | blockHash 32B | blockHeight u64 | blockTime u64 | outputCount u64 |
+            value u64 (base units) | scriptLen u64 | script 128B.
+Only transactions buried under at least minConfirmations blocks on EVERY configured node are
+answered; all nodes must agree byte-for-byte on the transaction's block and outputs, otherwise the
+service abstains (oracle error flag, no reply payload).
+
+The service reads the chain's own node software over its standard JSON-RPC
+(getrawtransaction / getblockheader), which dogecoind, bitcoind and litecoind share. Nodes must run
+with txindex=1 so any confirmed transaction can be looked up by id.
+
+Speaks the OM node <-> service protocol of oracles/core/base_oracle_service.cpp (same framing as
+read_evm_log):
+  query:  header 8B (size LE24 | type=190 | dejavu u32) | OracleMachineQuery 16B | payload 56B
+  reply:  header 8B (size LE24 | type=191 | dejavu=0)   | OracleMachineReply 16B | payload 208B
+
+Env: READ_UTXO_TX_SERVICE_PORT (default 9008),
+     UTXO_RPC_URLS_<NETWORK> comma-separated node URLs, e.g.
+       UTXO_RPC_URLS_DOGECOIN=http://user:pass@127.0.0.1:22555,http://user:pass@10.0.0.5:22555
+     with NETWORK one of DOGECOIN, BITCOIN, LITECOIN, DOGECOIN_TESTNET, BITCOIN_TESTNET4,
+     LITECOIN_TESTNET. Credentials in the URL are sent as HTTP basic auth.
+"""
+
+import base64
+import json
+import os
+import signal
+import socket
+import socketserver
+import struct
+import sys
+import urllib.error
+import urllib.parse
+import urllib.request
+from decimal import Decimal, InvalidOperation
+
+QUERY_SIZE = 56
+REPLY_SIZE = 208
+SCRIPT_CAPACITY = 128
+OM_QUERY_TYPE = 190
+OM_REPLY_TYPE = 191
+MAX_RPC_RESPONSE_BYTES = 8 * 1024 * 1024
+RPC_TIMEOUT_S = 10
+SOCKET_TIMEOUT_S = 600  # mirrors core's BaseOracleService::TIME_OUT_MS
+MAX_FRAME_BYTES = 4096  # larger frame means corrupt framing, not an unrelated message
+
+# Result codes (mirror core's OI::UtxoTxRead)
+SUCCESS = 0
+BAD_QUERY = 1
+NETWORK_UNSUPPORTED = 2
+TX_NOT_FOUND = 3
+NOT_CONFIRMED = 4
+OUTPUT_OUT_OF_RANGE = 5
+SCRIPT_TOO_LARGE = 6
+
+# Oracle error flags (mirror core's network_messages/common_def.h)
+NO_ERROR = 0x0
+ORACLE_UNAVAIL = 0x2
+INVALID_ARG = 0x10
+
+INTERFACE_INDEX = 6
+
+# Mirrors OI::UtxoTxRead::Network and minConfirmationsFor(): id -> (env name, minimum depth)
+NETWORKS = {
+    1: ("BITCOIN", 3),
+    2: ("DOGECOIN", 10),
+    3: ("LITECOIN", 6),
+    101: ("BITCOIN_TESTNET4", 1),
+    102: ("DOGECOIN_TESTNET", 1),
+    103: ("LITECOIN_TESTNET", 1),
+}
+MAX_CONFIRMATIONS = 1000
+
+COIN = Decimal(100_000_000)        # base units per coin on all three chains (koinu, satoshi, litoshi)
+MAX_U64 = (1 << 64) - 1
+RPC_INVALID_ADDRESS_OR_KEY = -5    # "No such mempool or blockchain transaction"
+
+
+class Abstain(Exception):
+    """Transport error, malformed data or node disagreement: commit nothing."""
+
+
+class Node:
+    """One JSON-RPC endpoint; credentials in the URL become an Authorization header."""
+
+    def __init__(self, url):
+        parts = urllib.parse.urlsplit(url)
+        self.auth = None
+        if parts.username is not None:
+            user = urllib.parse.unquote(parts.username)
+            password = urllib.parse.unquote(parts.password or "")
+            self.auth = "Basic " + base64.b64encode(f"{user}:{password}".encode()).decode()
+            netloc = parts.hostname + (f":{parts.port}" if parts.port else "")
+            url = urllib.parse.urlunsplit((parts.scheme, netloc, parts.path, parts.query, parts.fragment))
+        self.url = url
+
+    def call(self, method, params):
+        """Returns (result, error) of one JSON-RPC 1.0 call. Raises Abstain on transport failure."""
+        body = json.dumps({"jsonrpc": "1.0", "id": "qubic-om", "method": method, "params": params}).encode()
+        headers = {"Content-Type": "application/json"}
+        if self.auth:
+            headers["Authorization"] = self.auth
+        req = urllib.request.Request(self.url, data=body, headers=headers)
+        try:
+            with urllib.request.urlopen(req, timeout=RPC_TIMEOUT_S) as resp:
+                raw = resp.read(MAX_RPC_RESPONSE_BYTES + 1)
+        except urllib.error.HTTPError as e:  # bitcoind-family nodes answer RPC errors with HTTP 404/500
+            if e.code in (401, 403):
+                raise Abstain(f"node refused credentials (HTTP {e.code})") from e
+            raw = e.read(MAX_RPC_RESPONSE_BYTES + 1)
+        except Exception as e:
+            raise Abstain(f"transport: {e}") from e
+        if len(raw) > MAX_RPC_RESPONSE_BYTES:
+            raise Abstain("response too large")
+        try:
+            reply = json.loads(raw, parse_float=Decimal)  # amounts must never pass through float
+        except ValueError as e:
+            raise Abstain(f"bad json: {e}") from e
+        if not isinstance(reply, dict) or ("result" not in reply and "error" not in reply):
+            raise Abstain("not a JSON-RPC reply")
+        return reply.get("result"), reply.get("error")
+
+
+def load_networks():
+    networks = {}
+    for network_id, (name, min_conf) in NETWORKS.items():
+        urls = os.environ.get(f"UTXO_RPC_URLS_{name}", "")
+        nodes = [Node(u.strip()) for u in urls.split(",") if u.strip()]
+        if nodes:
+            networks[network_id] = {"name": name, "min_confirmations": min_conf, "nodes": nodes}
+    return networks
+
+
+def base_units(value):
+    """Exact coin amount (Decimal) -> integer base units; raises on anything not exact."""
+    if not isinstance(value, (Decimal, int)) or isinstance(value, bool):
+        raise Abstain(f"amount is not a number: {value!r}")
+    units = Decimal(value) * COIN
+    if units != units.to_integral_value() or units < 0 or units > MAX_U64:
+        raise Abstain(f"amount not representable in base units: {value}")
+    return int(units)
+
+
+def read_on_node(node, txid_hex):
+    """What one node says about the transaction: None (unknown), or a dict with its outputs and,
+    if it is in a block on the node's main chain, the block and confirmation count."""
+    tx, error = node.call("getrawtransaction", [txid_hex, 1])
+    if error:
+        if isinstance(error, dict) and error.get("code") == RPC_INVALID_ADDRESS_OR_KEY:
+            return None
+        raise Abstain(f"getrawtransaction error: {error}")
+    if not isinstance(tx, dict) or tx.get("txid") != txid_hex:
+        raise Abstain("node returned a different transaction")
+    outputs = []
+    for i, out in enumerate(tx["vout"]):
+        if out.get("n") != i:
+            raise Abstain("outputs not in order")
+        outputs.append((base_units(out["value"]), bytes.fromhex(out["scriptPubKey"]["hex"])))
+    seen = {"outputs": outputs, "block": None, "confirmations": 0}
+    block_hash = tx.get("blockhash")
+    if not block_hash:
+        return seen  # in the mempool
+    header, error = node.call("getblockheader", [block_hash, True])
+    if error or not isinstance(header, dict) or header.get("hash") != block_hash:
+        raise Abstain(f"getblockheader failed: {error}")
+    confirmations = int(header["confirmations"])
+    if confirmations < 1:
+        return seen  # block no longer on this node's main chain (reorganised away)
+    seen["block"] = (bytes.fromhex(block_hash), int(header["height"]), int(header["time"]))
+    seen["confirmations"] = confirmations
+    return seen
+
+
+def read_tx(network, txid_hex, min_conf):
+    """(code, facts) agreed by every node, or raises Abstain."""
+    views = [read_on_node(node, txid_hex) for node in network["nodes"]]
+    if all(v is None for v in views):
+        return TX_NOT_FOUND, None
+    if any(v is None for v in views):
+        raise Abstain("nodes disagree on whether the transaction exists")
+    if any(v["outputs"] != views[0]["outputs"] for v in views):
+        raise Abstain("nodes disagree on the transaction's outputs")
+    if any(v["block"] is None or v["confirmations"] < min_conf for v in views):
+        return NOT_CONFIRMED, None
+    if any(v["block"] != views[0]["block"] for v in views):
+        raise Abstain("nodes disagree on the containing block")
+    return SUCCESS, views[0]
+
+
+def code_reply(code):
+    return struct.pack("<Q", code) + bytes(REPLY_SIZE - 8)
+
+
+def handle_query(networks, payload):
+    """56B query payload -> (errorFlags, 208B reply payload). Abstains via non-zero flags."""
+    if len(payload) != QUERY_SIZE:
+        return INVALID_ARG, bytes(REPLY_SIZE)
+    network_id, txid, output_index, min_conf = struct.unpack("<Q32sQQ", payload)
+
+    if network_id not in NETWORKS:
+        return NO_ERROR, code_reply(NETWORK_UNSUPPORTED)
+    if txid == bytes(32) or not NETWORKS[network_id][1] <= min_conf <= MAX_CONFIRMATIONS:
+        return NO_ERROR, code_reply(BAD_QUERY)
+    if network_id not in networks:
+        return NO_ERROR, code_reply(NETWORK_UNSUPPORTED)
+
+    try:
+        code, facts = read_tx(networks[network_id], txid.hex(), min_conf)
+    except Exception as e:  # Abstain, or a malformed field (KeyError/ValueError) from a node
+        print(f"[ReadUtxoTx] abstain: {e}", file=sys.stderr)
+        return ORACLE_UNAVAIL, bytes(REPLY_SIZE)
+
+    if code != SUCCESS:
+        return NO_ERROR, code_reply(code)
+    outputs = facts["outputs"]
+    if output_index >= len(outputs):
+        return NO_ERROR, code_reply(OUTPUT_OUT_OF_RANGE)
+    value, script = outputs[output_index]
+    if len(script) > SCRIPT_CAPACITY:
+        return NO_ERROR, code_reply(SCRIPT_TOO_LARGE)
+    block_hash, height, block_time = facts["block"]
+    if len(block_hash) != 32:
+        return ORACLE_UNAVAIL, bytes(REPLY_SIZE)
+
+    reply = struct.pack("<Q", SUCCESS) + block_hash
+    reply += struct.pack("<QQQQQ", height, block_time, len(outputs), value, len(script))
+    reply += script + bytes(SCRIPT_CAPACITY - len(script))
+    assert len(reply) == REPLY_SIZE
+    return NO_ERROR, reply
+
+
+def recv_exact(sock, n):
+    buf = b""
+    while len(buf) < n:
+        chunk = sock.recv(n - len(buf))
+        if not chunk:
+            return None
+        buf += chunk
+    return buf
+
+
+class Handler(socketserver.BaseRequestHandler):
+    def setup(self):
+        self.request.settimeout(SOCKET_TIMEOUT_S)
+
+    def handle(self):
+        try:
+            self.serve()
+        except socket.timeout:
+            return  # idle too long; the node reconnects
+
+    def serve(self):
+        while True:
+            header = recv_exact(self.request, 8)
+            if header is None:
+                return
+            size = header[0] | (header[1] << 8) | (header[2] << 16)
+            msg_type = header[3]
+            if size < 8 or size > MAX_FRAME_BYTES:
+                return  # corrupt framing: cannot resync, drop the connection
+            body = recv_exact(self.request, size - 8)
+            if body is None:
+                return
+            if msg_type != OM_QUERY_TYPE or len(body) != 16 + QUERY_SIZE:
+                continue  # skip unrelated frames
+            query_id, interface_index = struct.unpack("<QI", body[:12])
+            if interface_index != INTERFACE_INDEX:
+                continue  # not our interface (misrouted config)
+            try:
+                flags, reply_payload = handle_query(self.server.networks, body[16:])
+            except Exception as e:  # structural backstop: never kill the OM connection
+                print(f"[ReadUtxoTx] abstain (unexpected): {e}", file=sys.stderr)
+                flags, reply_payload = ORACLE_UNAVAIL, bytes(REPLY_SIZE)
+
+            reply_size = 8 + 16 + REPLY_SIZE
+            packet = bytes([reply_size & 0xFF, (reply_size >> 8) & 0xFF,
+                            (reply_size >> 16) & 0xFF, OM_REPLY_TYPE]) + bytes(4)
+            packet += struct.pack("<QH6x", query_id, flags)
+            packet += reply_payload
+            self.request.sendall(packet)
+
+
+class Server(socketserver.ThreadingTCPServer):
+    allow_reuse_address = True
+    daemon_threads = True
+
+
+def main():
+    args = sys.argv[1:]
+    if args[:1] == ["--log"] and len(args) == 2:
+        log = open(args[1], "a", buffering=1)
+        sys.stdout = sys.stderr = log
+    elif args:
+        print(f"usage: {sys.argv[0]} [--log FILE]")
+        return 0 if args[:1] == ["--help"] else 1
+
+    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
+    urllib.request.install_opener(urllib.request.build_opener(urllib.request.ProxyHandler({})))
+    networks = load_networks()
+    if not networks:
+        print("No networks configured! Set UTXO_RPC_URLS_<NETWORK>, e.g. UTXO_RPC_URLS_DOGECOIN.", file=sys.stderr)
+        return 1
+    port = int(os.environ.get("READ_UTXO_TX_SERVICE_PORT", "9008"))
+    for network in networks.values():
+        print(f"[ReadUtxoTx] {network['name']}: {len(network['nodes'])} node(s), "
+              f"minimum {network['min_confirmations']} confirmations")
+    server = Server(("0.0.0.0", port), Handler)
+    server.networks = networks
+    print(f"[ReadUtxoTx] listening on {port}")
+    try:
+        server.serve_forever()
+    except KeyboardInterrupt:
+        pass
+    finally:
+        server.server_close()
+        print("[ReadUtxoTx] shutdown")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
