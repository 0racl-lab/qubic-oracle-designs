+#!/usr/bin/env python3
+"""Selftest for read_utxo_tx_service.py against mock_utxo_node.py. Run:
+    python3 test/mock_utxo_node.py --port 18745 &
+    python3 test/mock_utxo_node.py --port 18746 &
+    python3 test/mock_utxo_node.py --port 18747 --tamper &
+    python3 test/mock_utxo_node.py --port 18748 --lag 45 &
+    python3 test/selftest.py           (exit 0 = all pass)
+"""
+
+import os
+import socket
+import struct
+import sys
+import threading
+import urllib.request
+
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), ".."))
+urllib.request.install_opener(urllib.request.build_opener(urllib.request.ProxyHandler({})))
+
+import read_utxo_tx_service as svc
+
+DOGE = 2
+TXID_A = bytes.fromhex("d0" * 31 + "01")  # confirmed (50), 3 outputs
+TXID_M = bytes.fromhex("d0" * 31 + "02")  # mempool
+TXID_S = bytes.fromhex("d0" * 31 + "03")  # 5 confirmations
+TXID_O = bytes.fromhex("d0" * 31 + "04")  # orphaned block
+TXID_B = bytes.fromhex("d0" * 31 + "05")  # 200-byte script
+TXID_F = bytes.fromhex("d0" * 31 + "06")  # amount with 9 decimals
+TXID_X = bytes.fromhex("d0" * 31 + "ff")  # unknown
+BLOCK_A = bytes.fromhex("a1" * 32)
+P2PKH_SELLER = bytes.fromhex("76a914" + "5e" * 20 + "88ac")
+OP_RETURN_REF = bytes.fromhex("6a20" + "7a" * 32)
+
+NODE = "http://qubic:om@127.0.0.1:{}"
+failures = 0
+
+
+def check(cond, what):
+    global failures
+    print(f"  [{'PASS' if cond else 'FAIL'}] {what}")
+    if not cond:
+        failures += 1
+
+
+def query(network, txid, output, min_conf):
+    return struct.pack("<Q32sQQ", network, txid, output, min_conf)
+
+
+def u64(r, offset):
+    return struct.unpack("<Q", r[offset:offset + 8])[0]
+
+
+def use(*ports):
+    os.environ["UTXO_RPC_URLS_DOGECOIN"] = ",".join(NODE.format(p) for p in ports)
+    return svc.load_networks()
+
+
+def main():
+    networks = use(18745, 18746)
+
+    print("SUCCESS (Dogecoin payment output, 50 confirmations, two nodes agree):")
+    flags, r = svc.handle_query(networks, query(DOGE, TXID_A, 0, 30))
+    check(flags == svc.NO_ERROR, "service answers")
+    check(len(r) == 208, "reply is 208 bytes")
+    check(u64(r, 0) == svc.SUCCESS, "code == SUCCESS")
+    check(r[8:40] == BLOCK_A, "blockHash in display order")
+    check(u64(r, 40) == 5_400_000 - 49, "blockHeight")
+    check(u64(r, 48) == 1764000000, "blockTime")
+    check(u64(r, 56) == 3, "outputCount == 3")
+    check(u64(r, 64) == 123_456_789_012, "value 1234.56789012 DOGE == 123,456,789,012 koinu (exact)")
+    check(u64(r, 72) == 25 and r[80:105] == P2PKH_SELLER, "P2PKH script byte-exact")
+    check(r[105:] == bytes(103), "script tail zero-padded")
+
+    flags, r = svc.handle_query(networks, query(DOGE, TXID_A, 1, 30))
+    check(u64(r, 0) == svc.SUCCESS and u64(r, 64) == 0 and r[80:114] == OP_RETURN_REF,
+          "OP_RETURN output: value 0, 32-byte trade reference readable")
+    flags, r = svc.handle_query(networks, query(DOGE, TXID_A, 2, 30))
+    check(u64(r, 64) == 9_876_543_210_000, "large amount 98765.4321 DOGE exact")
+
+    print("Result codes:")
+    flags, r = svc.handle_query(networks, query(DOGE, TXID_X, 0, 30))
+    check(flags == svc.NO_ERROR and u64(r, 0) == svc.TX_NOT_FOUND and r[8:] == bytes(200),
+          "unknown tx (node error -5 over HTTP 500): code 3, rest zero")
+    flags, r = svc.handle_query(networks, query(DOGE, TXID_M, 0, 10))
+    check(u64(r, 0) == svc.NOT_CONFIRMED, "mempool tx: code 4")
+    flags, r = svc.handle_query(networks, query(DOGE, TXID_S, 0, 10))
+    check(u64(r, 0) == svc.NOT_CONFIRMED, "5 confirmations, 10 required: code 4")
+    flags, r = svc.handle_query(networks, query(DOGE, TXID_O, 0, 10))
+    check(u64(r, 0) == svc.NOT_CONFIRMED, "block reorganised away: code 4")
+    flags, r = svc.handle_query(networks, query(DOGE, TXID_A, 3, 30))
+    check(u64(r, 0) == svc.OUTPUT_OUT_OF_RANGE, "output 3 of 3: code 5")
+    flags, r = svc.handle_query(networks, query(DOGE, TXID_B, 0, 30))
+    check(u64(r, 0) == svc.SCRIPT_TOO_LARGE, "200-byte script: code 6")
+    flags, r = svc.handle_query(networks, query(1, TXID_A, 0, 6))
+    check(u64(r, 0) == svc.NETWORK_UNSUPPORTED, "Bitcoin known but not configured: code 2")
+    flags, r = svc.handle_query(networks, query(4, TXID_A, 0, 6))
+    check(u64(r, 0) == svc.NETWORK_UNSUPPORTED, "unknown network 4: code 2")
+    flags, r = svc.handle_query(networks, query(0, TXID_A, 0, 6))
+    check(u64(r, 0) == svc.NETWORK_UNSUPPORTED, "network 0 (all-zero query): code 2")
+
+    print("Malformed queries (code 1):")
+    flags, r = svc.handle_query(networks, query(DOGE, bytes(32), 0, 30))
+    check(u64(r, 0) == svc.BAD_QUERY, "zero txid")
+    flags, r = svc.handle_query(networks, query(DOGE, TXID_A, 0, 9))
+    check(u64(r, 0) == svc.BAD_QUERY, "9 confirmations is below Dogecoin's minimum of 10")
+    flags, r = svc.handle_query(networks, query(DOGE, TXID_A, 0, 1001))
+    check(u64(r, 0) == svc.BAD_QUERY, "1001 confirmations is above the maximum")
+    flags, r = svc.handle_query(networks, b"\x00" * 10)
+    check(flags == svc.INVALID_ARG, "wrong payload size: INVALID_ARG flag")
+
+    print("Confirmation boundary across nodes:")
+    flags, r = svc.handle_query(use(18745, 18748), query(DOGE, TXID_A, 0, 10))
+    check(u64(r, 0) == svc.NOT_CONFIRMED, "one node 45 blocks behind (5 conf there): code 4, not an answer")
+    flags, r = svc.handle_query(use(18745, 18748), query(DOGE, TXID_A, 0, 1000))
+    check(u64(r, 0) == svc.NOT_CONFIRMED, "deeper than either node: code 4")
+
+    print("Abstain (no reply payload committed):")
+    flags, r = svc.handle_query(use(18745, 18747), query(DOGE, TXID_A, 0, 30))
+    check(flags != svc.NO_ERROR and r == bytes(208), "node with a different amount: disagreement")
+    flags, r = svc.handle_query(use(18745, 1), query(DOGE, TXID_A, 0, 30))
+    check(flags != svc.NO_ERROR, "dead node")
+    flags, r = svc.handle_query(networks, query(DOGE, TXID_F, 0, 30))
+    check(flags != svc.NO_ERROR, "amount with 9 decimals: never rounded")
+    os.environ["UTXO_RPC_URLS_DOGECOIN"] = "http://qubic:wrong@127.0.0.1:18745"
+    flags, r = svc.handle_query(svc.load_networks(), query(DOGE, TXID_A, 0, 30))
+    check(flags != svc.NO_ERROR, "wrong RPC password")
+
+    print("Wire protocol (OM node framing over TCP):")
+    server = svc.Server(("127.0.0.1", 0), svc.Handler)
+    server.networks = use(18745, 18746)
+    threading.Thread(target=server.serve_forever, daemon=True).start()
+    payload = query(DOGE, TXID_A, 0, 30)
+    size = 8 + 16 + len(payload)
+    frame = bytes([size & 0xFF, (size >> 8) & 0xFF, size >> 16, svc.OM_QUERY_TYPE]) + bytes(4)
+    frame += struct.pack("<QII", 4242, svc.INTERFACE_INDEX, 30000) + payload
+    with socket.create_connection(server.server_address, timeout=10) as s:
+        s.sendall(frame)
+        reply = svc.recv_exact(s, 8 + 16 + 208)
+    check(reply[3] == svc.OM_REPLY_TYPE and struct.unpack("<Q", reply[8:16])[0] == 4242,
+          "reply frame carries type 191 and the query id")
+    check(struct.unpack("<H", reply[16:18])[0] == svc.NO_ERROR and u64(reply[24:], 64) == 123_456_789_012,
+          "no error flags, value in the payload")
+    server.shutdown()
+
+    print(f"{'SELFTEST FAILED' if failures else 'SELFTEST PASSED'} ({failures} failure(s))")
+    return 1 if failures else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
