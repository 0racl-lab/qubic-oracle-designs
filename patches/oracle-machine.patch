@@ -0,0 +1,56 @@
+#!/usr/bin/env python3
+"""Run one real EvmCallRead query through the service logic against live RPC endpoints.
+
+    EVM_RPC_URLS_8453=https://base-rpc.publicnode.com,https://mainnet.base.org \
+    python3 test/live_check.py 8453 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913 0x<holder>
+
+Calls balanceOf(holder) on the token at the chain's current finalized block (or at --block N) and
+prints the decoded reply. Nothing is sent to Qubic.
+"""
+
+import argparse
+import os
+import struct
+import sys
+import urllib.request
+
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), ".."))
+import read_evm_call_service as svc
+
+NAMES = {0: "SUCCESS", 1: "BAD_QUERY", 2: "CHAIN_UNSUPPORTED", 3: "BLOCK_NOT_FINALIZED",
+         4: "BLOCK_TOO_OLD", 5: "OUT_OF_GAS", 6: "RETURN_TOO_LARGE"}
+
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("chain", type=int)
+    p.add_argument("token")
+    p.add_argument("holder")
+    p.add_argument("--block", type=int, help="block number (default: the finalized head)")
+    a = p.parse_args()
+    urllib.request.install_opener(urllib.request.build_opener(urllib.request.ProxyHandler({})))
+    chains = svc.load_chains()
+    if a.chain not in chains:
+        print(f"set EVM_RPC_URLS_{a.chain}")
+        return 1
+    block = a.block if a.block is not None else svc.finalized_head(chains[a.chain]["endpoints"][0], chains[a.chain])[0]
+    to = bytes.fromhex(a.token[2:].lower())
+    holder = bytes.fromhex(a.holder[2:].lower())
+    calldata = bytes.fromhex("70a08231") + bytes(12) + holder
+    payload = struct.pack("<QQ32sQ512s", a.chain, block, bytes(12) + to, len(calldata), calldata + bytes(512 - len(calldata)))
+    flags, r = svc.handle_query(chains, payload)
+    if flags:
+        print(f"abstained (flags {flags:#x}): see the message above")
+        return 2
+    code = struct.unpack("<Q", r[:8])[0]
+    print(f"block {block}: code {code} {NAMES.get(code, '?')}")
+    if code == 0:
+        n = struct.unpack("<Q", r[48:56])[0]
+        print(f"blockHash 0x{r[8:40].hex()}  reverted {r[40]}  dataLen {n}")
+        if n == 32:
+            print(f"balanceOf = {int.from_bytes(r[56:88], 'big')}")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/oracles/read_evm_call/test/mock_evm_rpc.py b/oracles/read_evm_call/test/mock_evm_rpc.py
new file mode 100755
index 0000000..2d44da7
--- /dev/null
+++ b/oracles/read_evm_call/test/mock_evm_rpc.py
@@ -0,0 +1,123 @@
+#!/usr/bin/env python3
+"""Minimal mock EVM JSON-RPC server for the read_evm_call oracle service selftest.
+
+Serves eth_getBlockByNumber and eth_call. eth_call is only answered when the service sends exactly
+what core's OI::EvmCallRead requires (zero sender, GAS_CAP gas, block pinned by hash per EIP-1898);
+anything else gets an "unrecognised" error, which makes the service abstain and the test fail.
+Run one instance per fake "provider"; --tamper changes one return value so provider-disagreement
+handling can be tested.
+
+Usage: mock_evm_rpc.py --port 18645 [--tamper]
+"""
+
+import argparse
+import json
+from http.server import BaseHTTPRequestHandler, HTTPServer
+
+GAS_CAP = hex(10_000_000)
+ZERO = "0x" + "00" * 20
+
+FINALIZED = 0x1FF
+FINALIZED_TIME = 0x64000000
+# blocks the mock knows: number -> (hash, timestamp)
+BLOCKS = {
+    0x100: ("0x" + "cc" * 32, FINALIZED_TIME - 3600),        # an hour before the finalized head
+    0x10: ("0x" + "c1" * 32, FINALIZED_TIME - 2 * 86400),    # two days before: outside the window
+    FINALIZED: ("0x" + "cf" * 32, FINALIZED_TIME),
+}
+LATEST = 0x210
+
+TOKEN = "0x" + "a0" * 20       # balanceOf -> 1,000,000
+REVERTER = "0x" + "a1" * 20    # reverts with Error(string) "nope"
+BURNER = "0x" + "a2" * 20      # runs out of gas
+BIG = "0x" + "a3" * 20         # returns 600 bytes
+BROKEN = "0x" + "a4" * 20      # node-specific failure the service doesn't recognise
+BADOP = "0x" + "a5" * 20       # hits an invalid opcode
+
+BALANCE_OF = "0x70a08231"
+# Error(string) "nope"
+REVERT_DATA = ("0x08c379a0" + "20".rjust(64, "0") + "4".rjust(64, "0") + "6e6f7065".ljust(64, "0"))
+
+
+def block(number):
+    h, t = BLOCKS[number]
+    return {"number": hex(number), "hash": h, "timestamp": hex(t), "parentHash": "0x" + "00" * 32}
+
+
+def eth_call(call, pin, tamper):
+    """Returns (result, error)."""
+    if call.get("from") != ZERO or call.get("gas") != GAS_CAP:
+        return None, {"code": -32602, "message": "unexpected call params (from/gas)"}
+    if not isinstance(pin, dict) or pin.get("requireCanonical") is not True:
+        return None, {"code": -32602, "message": "call not pinned by block hash"}
+    known = {h for h, _ in BLOCKS.values()}
+    if pin.get("blockHash") not in known:
+        return None, {"code": -32000, "message": "header not found"}
+    to, data = call.get("to"), call.get("data", "")
+    if to == TOKEN and data.startswith(BALANCE_OF):
+        value = 1_000_000 + (1 if tamper else 0)
+        return "0x" + format(value, "064x"), None
+    if to == REVERTER:
+        return None, {"code": 3, "message": "execution reverted: nope", "data": REVERT_DATA}
+    if to == BURNER:
+        return None, {"code": -32000, "message": "out of gas"}
+    if to == BIG:
+        return "0x" + "ab" * 600, None
+    if to == BADOP:
+        return None, {"code": -32000, "message": "invalid opcode: INVALID"}
+    if to == BROKEN:
+        return None, {"code": -32000, "message": "missing trie node 1234 (path )"}
+    return "0x", None  # an address with no code returns empty data
+
+
+class Handler(BaseHTTPRequestHandler):
+    tamper = False
+
+    def log_message(self, fmt, *args):  # quiet
+        pass
+
+    def do_POST(self):
+        length = int(self.headers.get("Content-Length", 0))
+        request = json.loads(self.rfile.read(length))
+        method = request.get("method")
+        params = request.get("params", [])
+        result, error = None, None
+
+        if method == "eth_getBlockByNumber":
+            tag = params[0]
+            if tag == "finalized":
+                result = block(FINALIZED)
+            elif tag == "latest":
+                result = {"number": hex(LATEST), "hash": "0x" + "ee" * 32, "timestamp": hex(FINALIZED_TIME + 60)}
+            else:
+                number = int(tag, 16)
+                result = block(number) if number in BLOCKS else None
+        elif method == "eth_call":
+            result, error = eth_call(params[0], params[1], self.tamper)
+        else:
+            error = {"code": -32601, "message": "method not found"}
+
+        reply = {"jsonrpc": "2.0", "id": request.get("id")}
+        if error:
+            reply["error"] = error
+        else:
+            reply["result"] = result
+        body = json.dumps(reply).encode()
+        self.send_response(200)
+        self.send_header("Content-Type", "application/json")
+        self.send_header("Content-Length", str(len(body)))
+        self.end_headers()
+        self.wfile.write(body)
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--port", type=int, required=True)
+    parser.add_argument("--tamper", action="store_true")
+    args = parser.parse_args()
+    Handler.tamper = args.tamper
+    HTTPServer(("127.0.0.1", args.port), Handler).serve_forever()
+
+
+if __name__ == "__main__":
+    main()
