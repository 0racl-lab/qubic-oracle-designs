@@ -0,0 +1,152 @@
+#!/usr/bin/env python3
+"""Selftest for read_evm_call_service.py against mock_evm_rpc.py. Run:
+    python3 test/mock_evm_rpc.py --port 18645 &
+    python3 test/mock_evm_rpc.py --port 18646 &
+    python3 test/mock_evm_rpc.py --port 18647 --tamper &
+    python3 test/selftest.py           (exit 0 = all pass)
+"""
+
+import os
+import socket
+import struct
+import sys
+import threading
+import urllib.request
+
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), ".."))
+urllib.request.install_opener(urllib.request.build_opener(urllib.request.ProxyHandler({})))
+
+import read_evm_call_service as svc
+
+TOKEN = bytes.fromhex("a0" * 20)
+REVERTER = bytes.fromhex("a1" * 20)
+BURNER = bytes.fromhex("a2" * 20)
+BIG = bytes.fromhex("a3" * 20)
+BROKEN = bytes.fromhex("a4" * 20)
+BADOP = bytes.fromhex("a5" * 20)
+EOA = bytes.fromhex("e0" * 20)
+HOLDER = bytes.fromhex("bb" * 20)
+BALANCE_OF = bytes.fromhex("70a08231")
+BLOCK_HASH = bytes.fromhex("cc" * 32)
+
+failures = 0
+
+
+def check(cond, what):
+    global failures
+    print(f"  [{'PASS' if cond else 'FAIL'}] {what}")
+    if not cond:
+        failures += 1
+
+
+def query(chain_id, block, to20, calldata, to_word=None, length=None):
+    word = to_word if to_word is not None else bytes(12) + to20
+    n = len(calldata) if length is None else length
+    return struct.pack("<QQ32sQ512s", chain_id, block, word, n, calldata + bytes(512 - len(calldata)))
+
+
+def balance_of(holder):
+    return BALANCE_OF + bytes(12) + holder
+
+
+def code(r):
+    return struct.unpack("<Q", r[0:8])[0]
+
+
+def main():
+    os.environ["EVM_RPC_URLS_8453"] = "http://127.0.0.1:18645,http://127.0.0.1:18646"
+    chains = svc.load_chains()
+
+    print("SUCCESS (balanceOf at a finalized block):")
+    flags, r = svc.handle_query(chains, query(8453, 0x100, TOKEN, balance_of(HOLDER)))
+    check(flags == svc.NO_ERROR, "service answers")
+    check(len(r) == 568, "reply is 568 bytes")
+    check(code(r) == svc.SUCCESS, "code == SUCCESS")
+    check(r[8:40] == BLOCK_HASH, "blockHash is the hash of the block read")
+    check(struct.unpack("<Q", r[40:48])[0] == 0, "reverted == 0")
+    check(struct.unpack("<Q", r[48:56])[0] == 32, "dataLen == 32")
+    check(r[56:88] == (1_000_000).to_bytes(32, "big"), "return data byte-exact (1,000,000)")
+    check(r[88:] == bytes(480), "data tail zero-padded")
+
+    print("Deterministic outcomes that are not failures:")
+    flags, r = svc.handle_query(chains, query(8453, 0x100, REVERTER, bytes.fromhex("12345678")))
+    revert = bytes.fromhex("08c379a0") + (32).to_bytes(32, "big") + (4).to_bytes(32, "big") + b"nope" + bytes(28)
+    check(flags == svc.NO_ERROR and code(r) == svc.SUCCESS and struct.unpack("<Q", r[40:48])[0] == 1,
+          "revert: SUCCESS with reverted = 1")
+    check(struct.unpack("<Q", r[48:56])[0] == len(revert) and r[56:56 + len(revert)] == revert,
+          "revert data returned byte-exact (Error(string) 'nope')")
+    flags, r = svc.handle_query(chains, query(8453, 0x100, BADOP, bytes.fromhex("12345678")))
+    check(flags == svc.NO_ERROR and code(r) == svc.SUCCESS and r[40] == 1 and r[48] == 0,
+          "invalid opcode: reverted = 1, no data")
+    flags, r = svc.handle_query(chains, query(8453, 0x100, EOA, balance_of(HOLDER)))
+    check(flags == svc.NO_ERROR and code(r) == svc.SUCCESS and r[40] == 0 and r[48] == 0,
+          "address with no code: SUCCESS, empty data")
+
+    print("Result codes:")
+    flags, r = svc.handle_query(chains, query(8453, 0x300, TOKEN, balance_of(HOLDER)))
+    check(flags == svc.NO_ERROR and code(r) == svc.BLOCK_NOT_FINALIZED and r[8:] == bytes(560),
+          "block above finalized head: code 3, rest zero")
+    flags, r = svc.handle_query(chains, query(8453, 0x10, TOKEN, balance_of(HOLDER)))
+    check(flags == svc.NO_ERROR and code(r) == svc.BLOCK_TOO_OLD, "block outside the state window: code 4")
+    flags, r = svc.handle_query(chains, query(8453, 0x100, BURNER, bytes.fromhex("12345678")))
+    check(flags == svc.NO_ERROR and code(r) == svc.OUT_OF_GAS, "out of gas: code 5")
+    flags, r = svc.handle_query(chains, query(8453, 0x100, BIG, bytes.fromhex("12345678")))
+    check(flags == svc.NO_ERROR and code(r) == svc.RETURN_TOO_LARGE, "600-byte return: code 6")
+    flags, r = svc.handle_query(chains, query(1, 0x100, TOKEN, balance_of(HOLDER)))
+    check(flags == svc.NO_ERROR and code(r) == svc.CHAIN_UNSUPPORTED, "chain not configured: code 2")
+
+    print("Malformed queries (code 1):")
+    flags, r = svc.handle_query(chains, query(8453, 0x100, TOKEN, balance_of(HOLDER), to_word=b"\x01" + bytes(11) + TOKEN))
+    check(code(r) == svc.BAD_QUERY, "dirty upper 12 bytes of target")
+    flags, r = svc.handle_query(chains, query(8453, 0x100, bytes(20), balance_of(HOLDER)))
+    check(code(r) == svc.BAD_QUERY, "zero target address")
+    flags, r = svc.handle_query(chains, query(8453, 0x100, TOKEN, BALANCE_OF[:3], length=3))
+    check(code(r) == svc.BAD_QUERY, "calldata shorter than a selector")
+    flags, r = svc.handle_query(chains, query(8453, 0x100, TOKEN, balance_of(HOLDER), length=513))
+    check(code(r) == svc.BAD_QUERY, "calldataLen > 512")
+    flags, r = svc.handle_query(chains, query(8453, 0x100, TOKEN, balance_of(HOLDER) + b"\x01", length=36))
+    check(code(r) == svc.BAD_QUERY, "non-zero byte after calldataLen")
+    flags, r = svc.handle_query(chains, b"\x00" * 100)
+    check(flags == svc.INVALID_ARG, "wrong payload size: INVALID_ARG flag")
+
+    print("Abstain (no reply payload committed):")
+    flags, r = svc.handle_query(chains, query(8453, 0x100, BROKEN, bytes.fromhex("12345678")))
+    check(flags != svc.NO_ERROR and r == bytes(568), "unrecognised node error")
+    os.environ["EVM_RPC_URLS_8453"] = "http://127.0.0.1:18645,http://127.0.0.1:18647"
+    flags, r = svc.handle_query(svc.load_chains(), query(8453, 0x100, TOKEN, balance_of(HOLDER)))
+    check(flags != svc.NO_ERROR, "tampered provider: disagreement")
+    os.environ["EVM_RPC_URLS_8453"] = "http://127.0.0.1:18645,http://127.0.0.1:1"
+    flags, r = svc.handle_query(svc.load_chains(), query(8453, 0x100, TOKEN, balance_of(HOLDER)))
+    check(flags != svc.NO_ERROR, "dead endpoint")
+
+    print("Confirmation-depth finality (EVM_MIN_CONFIRMATIONS_8453=0x10 -> head 0x200):")
+    os.environ["EVM_RPC_URLS_8453"] = "http://127.0.0.1:18645"
+    os.environ["EVM_MIN_CONFIRMATIONS_8453"] = str(0x210 - 0x1FF)
+    flags, r = svc.handle_query(svc.load_chains(), query(8453, 0x100, TOKEN, balance_of(HOLDER)))
+    check(flags == svc.NO_ERROR and code(r) == svc.SUCCESS, "latest - N head answers")
+    del os.environ["EVM_MIN_CONFIRMATIONS_8453"]
+
+    print("Wire protocol (OM node framing over TCP):")
+    os.environ["EVM_RPC_URLS_8453"] = "http://127.0.0.1:18645,http://127.0.0.1:18646"
+    server = svc.Server(("127.0.0.1", 0), svc.Handler)
+    server.chains = svc.load_chains()
+    threading.Thread(target=server.serve_forever, daemon=True).start()
+    payload = query(8453, 0x100, TOKEN, balance_of(HOLDER))
+    size = 8 + 16 + len(payload)
+    frame = bytes([size & 0xFF, (size >> 8) & 0xFF, size >> 16, svc.OM_QUERY_TYPE]) + bytes(4)
+    frame += struct.pack("<QII", 777, svc.INTERFACE_INDEX, 30000) + payload
+    with socket.create_connection(server.server_address, timeout=10) as s:
+        s.sendall(frame)
+        reply = svc.recv_exact(s, 8 + 16 + 568)
+    check(reply[3] == svc.OM_REPLY_TYPE and struct.unpack("<Q", reply[8:16])[0] == 777,
+          "reply frame carries type 191 and the query id")
+    check(struct.unpack("<H", reply[16:18])[0] == svc.NO_ERROR and reply[24:32] == bytes(8),
+          "no error flags, code SUCCESS")
+    server.shutdown()
+
+    print(f"{'SELFTEST FAILED' if failures else 'SELFTEST PASSED'} ({failures} failure(s))")
+    return 1 if failures else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
