-// END EvmCallRead / UtxoTxRead interface tests
+// --- ContentRead oracle interface (read a file by its SHA-256 hash) ---
+
+TEST(ContentReadOracle, DataContract)
+{
+	using C = OI::ContentRead;
+
+	// registered at index 7
+	EXPECT_EQ(C::oracleInterfaceIndex, 7u);
+	EXPECT_LT(C::oracleInterfaceIndex, OI::oracleInterfacesCount);
+
+	EXPECT_LE(sizeof(C::OracleQuery), (size_t)MAX_ORACLE_QUERY_SIZE);
+	EXPECT_LE(sizeof(C::OracleReply), (size_t)MAX_ORACLE_REPLY_SIZE);
+
+	EXPECT_EQ(sizeof(C::OracleQuery), 208u);
+	EXPECT_EQ(sizeof(C::OracleReply), 536u);
+	EXPECT_EQ(offsetof(C::OracleQuery, locatorKind), 32u);
+	EXPECT_EQ(offsetof(C::OracleQuery, locatorLen), 40u);
+	EXPECT_EQ(offsetof(C::OracleQuery, locator), 48u);
+	EXPECT_EQ(offsetof(C::OracleQuery, maxFileSize), 112u);
+	EXPECT_EQ(offsetof(C::OracleQuery, mode), 120u);
+	EXPECT_EQ(offsetof(C::OracleQuery, offset), 128u);
+	EXPECT_EQ(offsetof(C::OracleQuery, length), 136u);
+	EXPECT_EQ(offsetof(C::OracleQuery, jsonPath), 144u);
+	EXPECT_EQ(offsetof(C::OracleReply, fileSize), 8u);
+	EXPECT_EQ(offsetof(C::OracleReply, dataLen), 16u);
+	EXPECT_EQ(offsetof(C::OracleReply, data), 24u);
+	EXPECT_EQ(C::MAX_DATA, 512u);
+
+	EXPECT_EQ(OI::oracleInterfaces[C::oracleInterfaceIndex].querySize, sizeof(C::OracleQuery));
+	EXPECT_EQ(OI::oracleInterfaces[C::oracleInterfaceIndex].replySize, sizeof(C::OracleReply));
+}
+
+// The fee grows with maxFileSize, so one cheap query can't make every oracle machine download a
+// large file: 50 QU + 10 QU per started MiB.
+TEST(ContentReadOracle, QueryFeeScalesWithMaxFileSize)
+{
+	using C = OI::ContentRead;
+
+	EXPECT_TRUE(OI::initOracleInterfaces());
+
+	C::OracleQuery query{};
+	query.maxFileSize = 1;
+	EXPECT_EQ(C::getQueryFee(query), 60);
+	query.maxFileSize = 1048576;
+	EXPECT_EQ(C::getQueryFee(query), 60);
+	query.maxFileSize = 1048577;
+	EXPECT_EQ(C::getQueryFee(query), 70);
+	query.maxFileSize = C::MAX_FILE_SIZE;
+	EXPECT_EQ(C::getQueryFee(query), 690);
+	query.maxFileSize = 0;
+	EXPECT_EQ(C::getQueryFee(query), 50);
+	EXPECT_GE(C::getQueryFee(query), MIN_ORACLE_QUERY_FEE);
+
+	auto* feeFunc = OI::getOracleQueryFeeFunc[C::oracleInterfaceIndex];
+	ASSERT_NE(feeFunc, nullptr);
+	query.maxFileSize = 3 * 1048576;
+	EXPECT_EQ(feeFunc(&query), 80);
+}
+
+TEST(ContentReadOracle, ResultCodesAndReplyHelpers)
+{
+	using C = OI::ContentRead;
+
+	EXPECT_EQ(C::RESULT_SUCCESS, 0u);
+	const QPI::uint64 failureCodes[] = {
+		C::RESULT_BAD_QUERY, C::RESULT_NOT_FOUND, C::RESULT_BAD_RANGE,
+		C::RESULT_NOT_JSON, C::RESULT_NO_FIELD, C::RESULT_VALUE_TOO_LARGE,
+	};
+	const unsigned n = sizeof(failureCodes) / sizeof(failureCodes[0]);
+	for (unsigned i = 0; i < n; ++i)
+	{
+		EXPECT_NE(failureCodes[i], C::RESULT_SUCCESS);
+		for (unsigned j = i + 1; j < n; ++j)
+			EXPECT_NE(failureCodes[i], failureCodes[j]);
+	}
+
+	C::OracleReply reply{};
+	reply.code = C::RESULT_SUCCESS;
+	EXPECT_TRUE(C::replyIsValid(reply));
+	reply.code = C::RESULT_NOT_FOUND;
+	EXPECT_FALSE(C::replyIsValid(reply));
+	EXPECT_TRUE(C::replyIsRetriable(reply));
+	reply.code = C::RESULT_NO_FIELD;
+	EXPECT_FALSE(C::replyIsRetriable(reply));
+}
+
+TEST(ContentReadOracle, DeterministicQueryBytes)
+{
+	using C = OI::ContentRead;
+
+	auto build = [](C::OracleQuery& q)
+	{
+		setMem(&q, sizeof(q), 0);
+		for (QPI::uint64 i = 0; i < 32; ++i)
+			q.sha256.set(i, (QPI::uint8)(0x90 + i));
+		const char cid[] = "bafkreigh2akiscaildcqabsyg3dfr6chu3fgpregiymsck7e7aqa4s52zy";
+		q.locatorKind = C::LocatorKind::ipfsCid;
+		q.locatorLen = sizeof(cid) - 1;
+		for (QPI::uint64 i = 0; i < q.locatorLen; ++i)
+			q.locator.set(i, (QPI::uint8)cid[i]);
+		q.maxFileSize = 4096;
+		q.mode = C::Mode::jsonField;
+		const char path[] = "meta.licence";
+		for (QPI::uint64 i = 0; i < sizeof(path) - 1; ++i)
+			q.jsonPath.set(i, (QPI::uint8)path[i]);
+	};
+
+	C::OracleQuery a, b;
+	build(a);
+	build(b);
+	EXPECT_EQ(compareMem(&a, &b, sizeof(C::OracleQuery)), 0);
+}
+
+// END EvmCallRead / UtxoTxRead / ContentRead interface tests
