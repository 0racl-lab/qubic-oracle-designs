-// END EvmCallRead / UtxoTxRead / ContentRead interface tests
+// --- EvmTxRead oracle interface (one finalized EVM transaction: block, time, sender, status) ---
+
+TEST(EvmTxReadOracle, DataContract)
+{
+	using E = OI::EvmTxRead;
+
+	// registered at index 8
+	EXPECT_EQ(E::oracleInterfaceIndex, 8u);
+	EXPECT_LT(E::oracleInterfaceIndex, OI::oracleInterfacesCount);
+
+	// fits within transaction limits
+	EXPECT_LE(sizeof(E::OracleQuery), (size_t)MAX_ORACLE_QUERY_SIZE);
+	EXPECT_LE(sizeof(E::OracleReply), (size_t)MAX_ORACLE_REPLY_SIZE);
+
+	// pinned sizes and offsets (no padding holes)
+	EXPECT_EQ(sizeof(E::OracleQuery), 40u);
+	EXPECT_EQ(sizeof(E::OracleReply), 192u);
+	EXPECT_EQ(offsetof(E::OracleQuery, txHash), 8u);
+	EXPECT_EQ(offsetof(E::OracleReply, blockNumber), 8u);
+	EXPECT_EQ(offsetof(E::OracleReply, blockTimestamp), 16u);
+	EXPECT_EQ(offsetof(E::OracleReply, transactionIndex), 24u);
+	EXPECT_EQ(offsetof(E::OracleReply, blockHash), 32u);
+	EXPECT_EQ(offsetof(E::OracleReply, from), 64u);
+	EXPECT_EQ(offsetof(E::OracleReply, to), 96u);
+	EXPECT_EQ(offsetof(E::OracleReply, value), 128u);
+	EXPECT_EQ(offsetof(E::OracleReply, nonce), 160u);
+	EXPECT_EQ(offsetof(E::OracleReply, status), 168u);
+	EXPECT_EQ(offsetof(E::OracleReply, txType), 176u);
+	EXPECT_EQ(offsetof(E::OracleReply, logCount), 184u);
+
+	// registry size table matches the actual structs
+	EXPECT_EQ(OI::oracleInterfaces[E::oracleInterfaceIndex].querySize, sizeof(E::OracleQuery));
+	EXPECT_EQ(OI::oracleInterfaces[E::oracleInterfaceIndex].replySize, sizeof(E::OracleReply));
+}
+
+TEST(EvmTxReadOracle, QueryFeeAndChains)
+{
+	using E = OI::EvmTxRead;
+
+	EXPECT_TRUE(OI::initOracleInterfaces());
+
+	E::OracleQuery query{};
+	query.chainId = E::ChainId::ethereum;
+	EXPECT_EQ(E::getQueryFee(query), 1000);
+	EXPECT_GE(E::getQueryFee(query), MIN_ORACLE_QUERY_FEE);
+	auto* feeFunc = OI::getOracleQueryFeeFunc[E::oracleInterfaceIndex];
+	ASSERT_NE(feeFunc, nullptr);
+	EXPECT_EQ(feeFunc(&query), 1000);
+
+	// the same chains as EvmLogRead, with the same ids, so a log and its transaction use one chainId
+	const QPI::uint64 chains[] = { 1, 10, 56, 137, 250, 8453, 43114, 42161, 11155111 };
+	for (QPI::uint64 c : chains)
+	{
+		EXPECT_TRUE(E::isSupportedChain(c));
+		EXPECT_EQ(E::isSupportedChain(c), OI::EvmLogRead::isSupportedChain(c));
+	}
+	EXPECT_FALSE(E::isSupportedChain(0));
+	EXPECT_FALSE(E::isSupportedChain(2));
+	EXPECT_FALSE(E::isSupportedChain(999999));
+}
+
+TEST(EvmTxReadOracle, ResultCodesAndReplyHelpers)
+{
+	using E = OI::EvmTxRead;
+
+	EXPECT_EQ(E::RESULT_SUCCESS, 0u);
+	const QPI::uint64 failureCodes[] = {
+		E::RESULT_BAD_QUERY, E::RESULT_CHAIN_UNSUPPORTED, E::RESULT_TX_NOT_FOUND, E::RESULT_TX_NOT_FINALIZED,
+	};
+	const unsigned n = sizeof(failureCodes) / sizeof(failureCodes[0]);
+	for (unsigned i = 0; i < n; ++i)
+	{
+		EXPECT_NE(failureCodes[i], E::RESULT_SUCCESS);
+		for (unsigned j = i + 1; j < n; ++j)
+			EXPECT_NE(failureCodes[i], failureCodes[j]);
+	}
+
+	E::OracleReply reply{};
+	reply.code = E::RESULT_SUCCESS;
+	reply.status = E::STATUS_SUCCESS;
+	EXPECT_TRUE(E::replyIsValid(reply));
+	reply.status = E::STATUS_REVERTED;          // a reverted tx is a final answer, but not a usable payment
+	EXPECT_FALSE(E::replyIsValid(reply));
+	EXPECT_FALSE(E::replyIsRetriable(reply));
+	reply.status = E::STATUS_SUCCESS;
+	reply.code = E::RESULT_TX_NOT_FOUND;
+	EXPECT_FALSE(E::replyIsValid(reply));
+	EXPECT_TRUE(E::replyIsRetriable(reply));
+	reply.code = E::RESULT_TX_NOT_FINALIZED;
+	EXPECT_TRUE(E::replyIsRetriable(reply));
+	reply.code = E::RESULT_CHAIN_UNSUPPORTED;
+	EXPECT_FALSE(E::replyIsRetriable(reply));
+}
+
+// The block time converts to a QPI DateAndTime that compares with qpi.now()-style values.
+TEST(EvmTxReadOracle, BlockTimeAsDateAndTime)
+{
+	using E = OI::EvmTxRead;
+
+	E::OracleReply reply{};
+	reply.code = E::RESULT_SUCCESS;
+	QPI::DateAndTime t;
+
+	reply.blockTimestamp = 1700000000;              // 2023-11-14 22:13:20 UTC
+	ASSERT_TRUE(E::getBlockDateAndTime(reply, t));
+	EXPECT_EQ(t.getYear(), 2023);
+	EXPECT_EQ(t.getMonth(), 11);
+	EXPECT_EQ(t.getDay(), 14);
+	EXPECT_EQ(t.getHour(), 22);
+	EXPECT_EQ(t.getMinute(), 13);
+	EXPECT_EQ(t.getSecond(), 20);
+	EXPECT_TRUE(t == QPI::DateAndTime(2023, 11, 14, 22, 13, 20));
+
+	reply.blockTimestamp = 1709251199;              // 2024-02-29 23:59:59 UTC (leap day)
+	ASSERT_TRUE(E::getBlockDateAndTime(reply, t));
+	EXPECT_TRUE(t == QPI::DateAndTime(2024, 2, 29, 23, 59, 59));
+	QPI::DateAndTime opened(2024, 3, 1, 0, 0, 0);
+	EXPECT_TRUE(t < opened);                        // a payment one second before an order opened
+
+	reply.blockTimestamp = 0;
+	ASSERT_TRUE(E::getBlockDateAndTime(reply, t));
+	EXPECT_TRUE(t == QPI::DateAndTime(1970, 1, 1, 0, 0, 0));
+
+	reply.blockTimestamp = 1700000000;
+	reply.code = E::RESULT_TX_NOT_FINALIZED;        // no time from a failed reply
+	EXPECT_FALSE(E::getBlockDateAndTime(reply, t));
+}
+
+TEST(EvmTxReadOracle, DeterministicQueryBytes)
+{
+	using E = OI::EvmTxRead;
+
+	auto build = [](E::OracleQuery& q)
+	{
+		setMem(&q, sizeof(q), 0);
+		q.chainId = E::ChainId::ethereum;
+		for (QPI::uint64 i = 0; i < 32; ++i)
+			q.txHash.set(i, (QPI::uint8)(0x40 + i));
+	};
+
+	E::OracleQuery a, b;
+	build(a);
+	build(b);
+	EXPECT_EQ(compareMem(&a, &b, sizeof(E::OracleQuery)), 0);
+
+	unsigned char buffer[MAX_ORACLE_QUERY_SIZE];
+	setMem(buffer, sizeof(buffer), 0);
+	copyMem(buffer, &a, sizeof(a));
+	E::OracleQuery roundtrip{};
+	copyMem(&roundtrip, buffer, sizeof(roundtrip));
+	EXPECT_EQ(compareMem(&a, &roundtrip, sizeof(E::OracleQuery)), 0);
+}
+
+// END EvmCallRead / UtxoTxRead / ContentRead / EvmTxRead interface tests
