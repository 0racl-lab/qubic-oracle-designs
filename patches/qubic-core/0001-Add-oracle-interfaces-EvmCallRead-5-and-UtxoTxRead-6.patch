+TEST(UtxoTxReadOracle, DeterministicQueryBytes)
+{
+	using U = OI::UtxoTxRead;
+
+	auto build = [](U::OracleQuery& q)
+	{
+		setMem(&q, sizeof(q), 0);
+		q.network = U::Network::dogecoin;
+		for (QPI::uint64 i = 0; i < 32; ++i)
+			q.txid.set(i, (QPI::uint8)(0x40 + i));
+		q.outputIndex = 1;
+		q.minConfirmations = 30;
+	};
+
+	U::OracleQuery a, b;
+	build(a);
+	build(b);
+	EXPECT_EQ(compareMem(&a, &b, sizeof(U::OracleQuery)), 0);
+}
