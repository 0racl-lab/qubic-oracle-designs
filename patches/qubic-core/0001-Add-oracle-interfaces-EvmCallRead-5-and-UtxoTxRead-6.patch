+TEST(UtxoTxReadOracle, ResultCodesAndReplyHelpers)
+{
+	using U = OI::UtxoTxRead;
+
+	EXPECT_EQ(U::RESULT_SUCCESS, 0u);
+	const QPI::uint64 failureCodes[] = {
+		U::RESULT_BAD_QUERY, U::RESULT_NETWORK_UNSUPPORTED, U::RESULT_TX_NOT_FOUND,
+		U::RESULT_NOT_CONFIRMED, U::RESULT_OUTPUT_OUT_OF_RANGE, U::RESULT_SCRIPT_TOO_LARGE,
+	};
+	const unsigned n = sizeof(failureCodes) / sizeof(failureCodes[0]);
+	for (unsigned i = 0; i < n; ++i)
+	{
+		EXPECT_NE(failureCodes[i], U::RESULT_SUCCESS);
+		for (unsigned j = i + 1; j < n; ++j)
+			EXPECT_NE(failureCodes[i], failureCodes[j]);
+	}
+
+	U::OracleReply reply{};
+	reply.code = U::RESULT_SUCCESS;
+	EXPECT_TRUE(U::replyIsValid(reply));
+	reply.code = U::RESULT_NOT_CONFIRMED;
+	EXPECT_FALSE(U::replyIsValid(reply));
+	EXPECT_TRUE(U::replyIsRetriable(reply));
+	reply.code = U::RESULT_TX_NOT_FOUND;
+	EXPECT_TRUE(U::replyIsRetriable(reply));
+	reply.code = U::RESULT_OUTPUT_OUT_OF_RANGE;
+	EXPECT_FALSE(U::replyIsRetriable(reply));
+}
