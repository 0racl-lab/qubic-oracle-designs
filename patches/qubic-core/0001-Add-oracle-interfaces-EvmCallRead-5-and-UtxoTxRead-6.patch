+TEST(UtxoTxReadOracle, QueryFeeNetworksAndDepth)
+{
+	using U = OI::UtxoTxRead;
+
+	EXPECT_TRUE(OI::initOracleInterfaces());
+
+	U::OracleQuery query{};
+	query.network = U::Network::dogecoin;
+	EXPECT_EQ(U::getQueryFee(query), 1000);
+	EXPECT_GE(U::getQueryFee(query), MIN_ORACLE_QUERY_FEE);
+	auto* feeFunc = OI::getOracleQueryFeeFunc[U::oracleInterfaceIndex];
+	ASSERT_NE(feeFunc, nullptr);
+	EXPECT_EQ(feeFunc(&query), 1000);
+
+	// networks: 0 is invalid so an all-zero query never names a chain
+	EXPECT_FALSE(U::isSupportedNetwork(0));
+	EXPECT_TRUE(U::isSupportedNetwork(U::Network::bitcoin));
+	EXPECT_TRUE(U::isSupportedNetwork(U::Network::dogecoin));
+	EXPECT_TRUE(U::isSupportedNetwork(U::Network::litecoin));
+	EXPECT_TRUE(U::isSupportedNetwork(U::Network::bitcoinTestnet4));
+	EXPECT_TRUE(U::isSupportedNetwork(U::Network::dogecoinTestnet));
+	EXPECT_TRUE(U::isSupportedNetwork(U::Network::litecoinTestnet));
+	EXPECT_FALSE(U::isSupportedNetwork(4));
+
+	// per-network minimum depth
+	EXPECT_EQ(U::minConfirmationsFor(U::Network::bitcoin), 3u);
+	EXPECT_EQ(U::minConfirmationsFor(U::Network::dogecoin), 10u);
+	EXPECT_EQ(U::minConfirmationsFor(U::Network::litecoin), 6u);
+	EXPECT_EQ(U::minConfirmationsFor(U::Network::dogecoinTestnet), 1u);
+	EXPECT_EQ(U::minConfirmationsFor(0), 0u);
+
+	query.minConfirmations = 9;
+	EXPECT_FALSE(U::queryIsWellFormed(query));  // too shallow for Dogecoin
+	query.minConfirmations = 10;
+	EXPECT_TRUE(U::queryIsWellFormed(query));
+	query.minConfirmations = U::MAX_CONFIRMATIONS;
+	EXPECT_TRUE(U::queryIsWellFormed(query));
+	query.minConfirmations = U::MAX_CONFIRMATIONS + 1;
+	EXPECT_FALSE(U::queryIsWellFormed(query));
+	query.network = 0;
+	query.minConfirmations = 10;
+	EXPECT_FALSE(U::queryIsWellFormed(query));
+}
