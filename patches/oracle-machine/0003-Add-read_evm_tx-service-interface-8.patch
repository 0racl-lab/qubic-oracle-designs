+#!/usr/bin/env python3
+"""Selftest for read_evm_tx_service.py against mock_evm_rpc.py. Run:
+    python3 test/mock_evm_rpc.py --port 18945 &
+    python3 test/mock_evm_rpc.py --port 18946 &
+    python3 test/mock_evm_rpc.py --port 18947 --tamper &
+    python3 test/mock_evm_rpc.py --port 18948 --lag &
+    python3 test/selftest.py           (exit 0 = all pass)
+"""
+
+import os
+import socket
+import struct
+import sys
+import threading
+import urllib.request
+
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), ".."))
+urllib.request.install_opener(urllib.request.build_opener(urllib.request.ProxyHandler({})))
+
+import read_evm_tx_service as svc
+
+T0 = 0x64000000
+SENDER = bytes(12) + bytes.fromhex("5e" * 20)
+TOKEN = bytes(12) + bytes.fromhex("a0" * 20)
+GOOD = "http://127.0.0.1:18945,http://127.0.0.1:18946"
+
+failures = 0
+
+
+def check(cond, what):
+    global failures
+    print(f"  [{'PASS' if cond else 'FAIL'}] {what}")
+    if not cond:
+        failures += 1
+
+
+def query(chain_id, c):
+    return struct.pack("<Q32s", chain_id, bytes.fromhex(c * 32))
+
+
+def u64(r, off):
+    return struct.unpack("<Q", r[off:off + 8])[0]
+
+
+def run(urls, c, chain_id=1, extra=None):
+    os.environ["EVM_RPC_URLS_1"] = urls
+    for k, v in (extra or {}).items():
+        os.environ[k] = v
+    try:
+        return svc.handle_query(svc.load_chains(), query(chain_id, c))
+    finally:
+        for k in (extra or {}):
+            del os.environ[k]
+
+
+def main():
+    print("SUCCESS (finalized token transfer):")
+    flags, r = run(GOOD, "01")
+    check(flags == svc.NO_ERROR, "service answers")
+    check(len(r) == 192, "reply is 192 bytes")
+    check(u64(r, 0) == svc.SUCCESS, "code == SUCCESS")
+    check(u64(r, 8) == 0x100, "blockNumber")
+    check(u64(r, 16) == T0, "blockTimestamp from the block the receipt names")
+    check(u64(r, 24) == 3, "transactionIndex")
+    check(r[32:64] == bytes.fromhex("b1" * 32), "blockHash")
+    check(r[64:96] == SENDER, "from, right-aligned")
+    check(r[96:128] == TOKEN, "to, right-aligned")
+    check(r[128:160] == bytes(32), "value 0")
+    check(u64(r, 160) == 7 and u64(r, 168) == 1 and u64(r, 176) == 2 and u64(r, 184) == 1,
+          "nonce 7, status 1, type 2, 1 log")
+
+    print("Final facts that are not failures:")
+    flags, r = run(GOOD, "02")
+    check(flags == svc.NO_ERROR and u64(r, 0) == svc.SUCCESS and u64(r, 168) == 0 and u64(r, 8) == 0x101,
+          "reverted tx: SUCCESS with status 0")
+    flags, r = run(GOOD, "05")
+    check(flags == svc.NO_ERROR and u64(r, 0) == svc.SUCCESS and r[96:128] == bytes(32),
+          "contract creation: to all zero")
+    check(r[128:160] == (5 * 10**18).to_bytes(32, "big"), "value 5 ETH as uint256 big-endian")
+    check(u64(r, 176) == 0, "legacy tx without a type field: type 0")
+
+    print("Result codes:")
+    flags, r = run(GOOD, "99")
+    check(flags == svc.NO_ERROR and u64(r, 0) == svc.TX_NOT_FOUND and r[8:] == bytes(184),
+          "unknown tx: code 3, rest zero")
+    flags, r = run(GOOD, "03")
+    check(flags == svc.NO_ERROR and u64(r, 0) == svc.TX_NOT_FINALIZED and r[8:] == bytes(184),
+          "pending tx: code 4, rest zero")
+    flags, r = run(GOOD, "04")
+    check(flags == svc.NO_ERROR and u64(r, 0) == svc.TX_NOT_FINALIZED, "mined above the finalized head: code 4")
+    flags, r = run(GOOD, "01", chain_id=8453)
+    check(flags == svc.NO_ERROR and u64(r, 0) == svc.CHAIN_UNSUPPORTED, "chain not configured: code 2")
+    flags, r = svc.handle_query(svc.load_chains(), struct.pack("<Q32s", 1, bytes(32)))
+    check(flags == svc.NO_ERROR and u64(r, 0) == svc.BAD_QUERY, "zero tx hash: code 1")
+    flags, r = svc.handle_query(svc.load_chains(), bytes(39))
+    check(flags == svc.INVALID_ARG, "wrong payload size: INVALID_ARG flag")
+
+    print("Finality from every endpoint:")
+    flags, r = run("http://127.0.0.1:18945,http://127.0.0.1:18948", "01")
+    check(flags == svc.NO_ERROR and u64(r, 0) == svc.SUCCESS, "lagging node that has the tx: still SUCCESS")
+    os.environ["EVM_RPC_URLS_1"] = "http://127.0.0.1:18945"
+    flags, r = run("http://127.0.0.1:18945", "04", extra={"EVM_MIN_CONFIRMATIONS_1": str(0x210 - 0x206)})
+    check(flags == svc.NO_ERROR and u64(r, 0) == svc.SUCCESS, "latest - N head (0x206) covers block 0x205")
+    flags, r = run("http://127.0.0.1:18945", "04", extra={"EVM_MIN_CONFIRMATIONS_1": str(0x210 - 0x204)})
+    check(flags == svc.NO_ERROR and u64(r, 0) == svc.TX_NOT_FINALIZED, "latest - N head (0x204) does not")
+
+    print("Abstain (no reply payload committed):")
+    flags, r = run("http://127.0.0.1:18945,http://127.0.0.1:18947", "01")
+    check(flags != svc.NO_ERROR and r == bytes(192), "tampered provider: timestamp disagreement")
+    flags, r = run("http://127.0.0.1:18945,http://127.0.0.1:18948", "04")
+    check(flags != svc.NO_ERROR, "one node knows the tx, the other does not")
+    flags, r = run(GOOD, "06")
+    check(flags != svc.NO_ERROR, "mined tx without a receipt")
+    flags, r = run(GOOD, "07")
+    check(flags != svc.NO_ERROR, "receipt names another block")
+    flags, r = run(GOOD, "08")
+    check(flags != svc.NO_ERROR, "receipt's block not available")
+    flags, r = run("http://127.0.0.1:18945,http://127.0.0.1:1", "01")
+    check(flags != svc.NO_ERROR, "dead endpoint")
+
+    print("Wire protocol (OM node framing over TCP):")
+    os.environ["EVM_RPC_URLS_1"] = GOOD
+    server = svc.Server(("127.0.0.1", 0), svc.Handler)
+    server.chains = svc.load_chains()
+    threading.Thread(target=server.serve_forever, daemon=True).start()
+    payload = query(1, "01")
+    size = 8 + 16 + len(payload)
+    frame = bytes([size & 0xFF, (size >> 8) & 0xFF, size >> 16, svc.OM_QUERY_TYPE]) + bytes(4)
+    frame += struct.pack("<QII", 4242, svc.INTERFACE_INDEX, 30000) + payload
+    with socket.create_connection(server.server_address, timeout=10) as s:
+        s.sendall(frame)
+        reply = svc.recv_exact(s, 8 + 16 + 192)
+    check(reply[3] == svc.OM_REPLY_TYPE and struct.unpack("<Q", reply[8:16])[0] == 4242,
+          "reply frame carries type 191 and the query id")
+    check(struct.unpack("<H", reply[16:18])[0] == svc.NO_ERROR and reply[24:32] == bytes(8)
+          and u64(reply[24:], 16) == T0, "no error flags, code SUCCESS, timestamp in place")
+    server.shutdown()
+
+    print(f"{'SELFTEST FAILED' if failures else 'SELFTEST PASSED'} ({failures} failure(s))")
+    return 1 if failures else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
-- 
