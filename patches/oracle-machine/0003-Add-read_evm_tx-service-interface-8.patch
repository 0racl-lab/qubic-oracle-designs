+#!/usr/bin/env python3
+"""Run one real EvmTxRead query through the service logic against live RPC endpoints.
+
+    EVM_RPC_URLS_1=https://ethereum-rpc.publicnode.com,https://eth.llamarpc.com \
+    python3 test/live_check.py 1 0x<txHash>
+
+Prints the decoded reply. Nothing is sent to Qubic.
+"""
+
+import argparse
+import datetime
+import os
+import struct
+import sys
+import urllib.request
+
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), ".."))
+import read_evm_tx_service as svc
+
+NAMES = {0: "SUCCESS", 1: "BAD_QUERY", 2: "CHAIN_UNSUPPORTED", 3: "TX_NOT_FOUND", 4: "TX_NOT_FINALIZED"}
+
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("chain", type=int)
+    p.add_argument("tx")
+    a = p.parse_args()
+    urllib.request.install_opener(urllib.request.build_opener(urllib.request.ProxyHandler({})))
+    chains = svc.load_chains()
+    if a.chain not in chains:
+        print(f"set EVM_RPC_URLS_{a.chain}")
+        return 1
+    tx = bytes.fromhex(a.tx[2:] if a.tx.startswith("0x") else a.tx)
+    flags, r = svc.handle_query(chains, struct.pack("<Q32s", a.chain, tx))
+    if flags:
+        print(f"abstained (flags {flags:#x}): see the message above")
+        return 2
+    code = struct.unpack("<Q", r[:8])[0]
+    print(f"code {code} {NAMES.get(code, '?')}")
+    if code == 0:
+        number, ts, index = struct.unpack("<QQQ", r[8:32])
+        nonce, status, typ, logs = struct.unpack("<QQQQ", r[160:192])
+        when = datetime.datetime.fromtimestamp(ts, datetime.timezone.utc).isoformat()
+        print(f"block {number} (0x{r[32:64].hex()}) at {ts} = {when}, index {index}")
+        print(f"from 0x{r[76:96].hex()}  to 0x{r[108:128].hex()}  value {int.from_bytes(r[128:160], 'big')} wei")
+        print(f"nonce {nonce}  status {status}  type {typ}  logs {logs}")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/oracles/read_evm_tx/test/mock_evm_rpc.py b/oracles/read_evm_tx/test/mock_evm_rpc.py
new file mode 100755
index 0000000..02c6b7c
--- /dev/null
+++ b/oracles/read_evm_tx/test/mock_evm_rpc.py
@@ -0,0 +1,151 @@
+#!/usr/bin/env python3
+"""Minimal mock EVM JSON-RPC server for the read_evm_tx oracle service selftest.
+
+Serves eth_getBlockByNumber, eth_getBlockByHash, eth_getTransactionByHash and
+eth_getTransactionReceipt for a handful of fixed transactions. Run one instance per fake
+"provider"; --tamper shifts one block timestamp by a second (provider disagreement), --lag makes
+the node one that has not seen the newest block yet.
+
+Usage: mock_evm_rpc.py --port 18945 [--tamper | --lag]
+"""
+
+import argparse
+import json
+from http.server import BaseHTTPRequestHandler, HTTPServer
+
+FINALIZED = 0x1FF
+LATEST = 0x210
+T0 = 0x64000000                      # timestamp of block 0x100
+
+BLOCKS = {                           # number -> (hash, timestamp)
+    0x100: ("0x" + "b1" * 32, T0),
+    0x101: ("0x" + "b2" * 32, T0 + 12),
+    0x180: ("0x" + "b8" * 32, T0 + 0x80 * 12),    # finalized, but eth_getBlockByHash won't return it
+    0x205: ("0x" + "b5" * 32, T0 + 0x105 * 12),   # above the finalized head
+    FINALIZED: ("0x" + "bf" * 32, T0 + 0xFF * 12),
+}
+
+SENDER = "0x" + "5e" * 20
+TOKEN = "0x" + "a0" * 20
+
+
+def h(c):
+    return "0x" + c * 32
+
+
+TX_OK = h("01")          # successful token transfer, finalized
+TX_REVERTED = h("02")    # reverted, finalized
+TX_PENDING = h("03")     # in the mempool
+TX_RECENT = h("04")      # mined above the finalized head
+TX_CREATE = h("05")      # contract creation, legacy (no "type" field), large value
+TX_NO_RECEIPT = h("06")  # mined but the node has no receipt
+TX_MISMATCH = h("07")    # receipt names another block
+TX_BLOCK_GONE = h("08")  # receipt's block cannot be fetched by hash
+
+# hash -> (block number or None, tx index, to, value, nonce, type or None, status, logs)
+TXS = {
+    TX_OK: (0x100, 3, TOKEN, 0, 7, "0x2", 1, 1),
+    TX_REVERTED: (0x101, 0, TOKEN, 0, 8, "0x2", 0, 0),
+    TX_PENDING: (None, None, TOKEN, 0, 9, "0x2", None, 0),
+    TX_RECENT: (0x205, 1, TOKEN, 0, 10, "0x2", 1, 2),
+    TX_CREATE: (0x100, 4, None, 5 * 10**18, 0, None, 1, 0),
+    TX_NO_RECEIPT: (0x100, 5, TOKEN, 0, 11, "0x2", 1, 0),
+    TX_MISMATCH: (0x100, 6, TOKEN, 0, 12, "0x2", 1, 0),
+    TX_BLOCK_GONE: (0x180, 2, TOKEN, 0, 13, "0x2", 1, 0),
+}
+
+
+class Handler(BaseHTTPRequestHandler):
+    tamper = False
+    lag = False
+
+    def log_message(self, fmt, *args):  # quiet
+        pass
+
+    def block(self, number):
+        if number not in BLOCKS or (self.lag and number > FINALIZED):
+            return None
+        bh, t = BLOCKS[number]
+        if self.tamper and number == 0x100:
+            t += 1
+        return {"number": hex(number), "hash": bh, "timestamp": hex(t), "parentHash": "0x" + "00" * 32}
+
+    def tx(self, txh):
+        if txh not in TXS:
+            return None
+        number, index, to, value, nonce, typ, _, _ = TXS[txh]
+        if self.lag and number is not None and number > FINALIZED:
+            return None                                  # this node hasn't seen the block yet
+        t = {"hash": txh, "from": SENDER, "to": to, "value": hex(value), "nonce": hex(nonce),
+             "blockNumber": None if number is None else hex(number),
+             "blockHash": None if number is None else BLOCKS[number][0],
+             "transactionIndex": None if index is None else hex(index), "input": "0x"}
+        if typ is not None:
+            t["type"] = typ
+        return t
+
+    def receipt(self, txh):
+        t = self.tx(txh)
+        if t is None or t["blockHash"] is None or txh == TX_NO_RECEIPT:
+            return None
+        number, index, _, _, _, _, status, logs = TXS[txh]
+        block_hash = BLOCKS[0x101][0] if txh == TX_MISMATCH else t["blockHash"]
+        return {"transactionHash": txh, "blockHash": block_hash, "blockNumber": hex(number),
+                "transactionIndex": hex(index), "from": SENDER, "status": hex(status),
+                "logs": [{"address": TOKEN, "topics": [], "data": "0x"}] * logs}
+
+    def do_POST(self):
+        length = int(self.headers.get("Content-Length", 0))
+        request = json.loads(self.rfile.read(length))
+        method = request.get("method")
+        params = request.get("params", [])
+        result, error = None, None
+
+        if method == "eth_getBlockByNumber":
+            tag = params[0]
+            if tag == "finalized":
+                result = self.block(FINALIZED)
+                if self.lag:
+                    result = dict(result, number=hex(FINALIZED - 0x80))
+            elif tag == "latest":
+                result = {"number": hex(FINALIZED if self.lag else LATEST), "hash": "0x" + "ee" * 32,
+                          "timestamp": hex(T0 + 0x110 * 12)}
+            else:
+                result = self.block(int(tag, 16))
+        elif method == "eth_getBlockByHash":
+            match = [n for n, (bh, _) in BLOCKS.items() if bh == params[0]]
+            gone = BLOCKS[TXS[TX_BLOCK_GONE][0]][0]
+            result = self.block(match[0]) if match and params[0] != gone else None
+        elif method == "eth_getTransactionByHash":
+            result = self.tx(params[0])
+        elif method == "eth_getTransactionReceipt":
+            result = self.receipt(params[0])
+        else:
+            error = {"code": -32601, "message": "method not found"}
+
+        reply = {"jsonrpc": "2.0", "id": request.get("id")}
+        if error:
+            reply["error"] = error
+        else:
+            reply["result"] = result
+        body = json.dumps(reply).encode()
+        self.send_response(200)
+        self.send_header("Content-Type", "application/json")
+        self.send_header("Content-Length", str(len(body)))
+        self.end_headers()
+        self.wfile.write(body)
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--port", type=int, required=True)
+    parser.add_argument("--tamper", action="store_true")
+    parser.add_argument("--lag", action="store_true")
+    args = parser.parse_args()
+    Handler.tamper = args.tamper
+    Handler.lag = args.lag
+    HTTPServer(("127.0.0.1", args.port), Handler).serve_forever()
+
+
+if __name__ == "__main__":
+    main()
