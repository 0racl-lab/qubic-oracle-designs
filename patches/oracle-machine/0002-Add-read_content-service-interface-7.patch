index 0000000..71ceafb
--- /dev/null
+++ b/oracles/read_content/read_content_service.py
@@ -0,0 +1,429 @@
+#!/usr/bin/env python3
+"""read_content oracle service (interface index 7): read a file named by its SHA-256 hash.
+
+Query 208B: sha256 32B | locatorKind u64 | locatorLen u64 | locator 64B | maxFileSize u64 | mode u64 |
+            offset u64 | length u64 | jsonPath 64B.
+Reply 536B: code u64 | fileSize u64 | dataLen u64 | data 512B.
+
+The file is fetched from the operator's IPFS gateways (locator = CID), Arweave gateways
+(locator = transaction id) and content mirrors (by hash), then SHA-256 of the full bytes must equal the
+query's hash: bytes that don't match are discarded, so every machine that answers holds the same file.
+A source that answers definitively (HTTP 404/410, wrong bytes, larger than maxFileSize) is a miss; a
+source that fails (timeout, connection error, 5xx, 429) is an error. If no source delivers the file and
+any source errored, the service abstains (oracle error flag, no reply payload); if every source missed,
+it answers RESULT_NOT_FOUND.
+
+Speaks the OM node <-> service protocol of oracles/core/base_oracle_service.cpp (same framing as
+read_evm_log):
+  query:  header 8B (size LE24 | type=190 | dejavu u32) | OracleMachineQuery 16B | payload 208B
+  reply:  header 8B (size LE24 | type=191 | dejavu=0)   | OracleMachineReply 16B | payload 536B
+
+Env: READ_CONTENT_SERVICE_PORT (default 9009),
+     CONTENT_IPFS_GATEWAYS     comma-separated base URLs, fetched as <base>/ipfs/<cid>
+     CONTENT_ARWEAVE_GATEWAYS  comma-separated base URLs, fetched as <base>/<id>
+     CONTENT_MIRRORS           comma-separated URL templates containing {sha256} (lowercase hex)
+     CONTENT_FETCH_TIMEOUT_S   per-source timeout in seconds (default 20)
+"""
+
+import hashlib
+import json
+import math
+import os
+import re
+import signal
+import socket
+import socketserver
+import struct
+import sys
+import urllib.error
+import urllib.request
+from decimal import Decimal
+
+QUERY_SIZE = 208
+REPLY_SIZE = 536
+DATA_CAPACITY = 512
+MAX_FILE_SIZE = 64 * 1024 * 1024
+OM_QUERY_TYPE = 190
+OM_REPLY_TYPE = 191
+SOCKET_TIMEOUT_S = 600  # mirrors core's BaseOracleService::TIME_OUT_MS
+MAX_FRAME_BYTES = 4096  # larger frame means corrupt framing, not an unrelated message
+CHUNK = 1 << 16
+
+# Mirrors OI::ContentRead
+LOCATOR_NONE, LOCATOR_IPFS, LOCATOR_ARWEAVE = 0, 1, 2
+MODE_SIZE, MODE_RANGE, MODE_JSON = 1, 2, 3
+SUCCESS = 0
+BAD_QUERY = 1
+NOT_FOUND = 2
+BAD_RANGE = 3
+NOT_JSON = 4
+NO_FIELD = 5
+VALUE_TOO_LARGE = 6
+
+# Oracle error flags (mirror core's network_messages/common_def.h)
+NO_ERROR = 0x0
+ORACLE_UNAVAIL = 0x2
+INVALID_ARG = 0x10
+
+INTERFACE_INDEX = 7
+
+CID_RE = re.compile(rb"[A-Za-z0-9]{1,64}")
+ARWEAVE_RE = re.compile(rb"[A-Za-z0-9_-]{43}")
+PATH_RE = re.compile(rb"[\x20-\x7e]{0,64}")
+
+
+class Abstain(Exception):
+    """A source failed, or data is malformed: commit nothing."""
+
+
+# ----------------------------------------------------------------------------- sources and fetching
+
+def load_config():
+    def split(name):
+        return [u.strip().rstrip("/") for u in os.environ.get(name, "").split(",") if u.strip()]
+    mirrors = [m for m in split("CONTENT_MIRRORS") if "{sha256}" in m]
+    return {
+        "ipfs": split("CONTENT_IPFS_GATEWAYS"),
+        "arweave": split("CONTENT_ARWEAVE_GATEWAYS"),
+        "mirrors": mirrors,
+        "timeout": float(os.environ.get("CONTENT_FETCH_TIMEOUT_S", "20")),
+    }
+
+
+def source_urls(config, sha_hex, kind, locator):
+    urls = []
+    if kind == LOCATOR_IPFS:
+        urls += [f"{g}/ipfs/{locator}" for g in config["ipfs"]]
+    elif kind == LOCATOR_ARWEAVE:
+        urls += [f"{g}/{locator}" for g in config["arweave"]]
+    urls += [m.replace("{sha256}", sha_hex) for m in config["mirrors"]]
+    return urls
+
+
+def fetch(url, max_size, timeout):
+    """Returns ("bytes", data) | ("miss", reason) | ("error", reason). Never reads more than max_size + 1."""
+    req = urllib.request.Request(url, headers={"Accept": "*/*", "User-Agent": "qubic-oracle-machine/read_content"})
+    try:
+        with urllib.request.urlopen(req, timeout=timeout) as resp:
+            length = resp.headers.get("Content-Length")
+            if length is not None and length.isdigit() and int(length) > max_size:
+                return "miss", "larger than maxFileSize (Content-Length)"
+            buf = bytearray()
+            while len(buf) <= max_size:
+                chunk = resp.read(min(CHUNK, max_size + 1 - len(buf)))
+                if not chunk:
+                    break
+                buf += chunk
+            if len(buf) > max_size:
+                return "miss", "larger than maxFileSize"
+            return "bytes", bytes(buf)
+    except urllib.error.HTTPError as e:
+        if e.code in (404, 410):
+            return "miss", f"HTTP {e.code}"
+        return "error", f"HTTP {e.code}"
+    except Exception as e:  # timeout, refused, DNS, TLS, truncated body
+        return "error", str(e)
+
+
+def find_file(config, sha256, kind, locator, max_size):
+    """The verified bytes, None if every source missed, or raises Abstain if any source errored."""
+    errors = []
+    for url in source_urls(config, sha256.hex(), kind, locator):
+        status, value = fetch(url, max_size, config["timeout"])
+        if status == "bytes":
+            if hashlib.sha256(value).digest() == sha256:
+                return value
+            continue  # wrong bytes: this source is useless for this hash, try the next
+        if status == "error":
+            errors.append(f"{url}: {value}")
+    if errors:
+        raise Abstain("no verified copy and some sources failed: " + "; ".join(errors))
+    return None
+
+
+# ----------------------------------------------------------------------------- JSON (RFC 8785 JCS)
+
+class NotJson(Exception):
+    pass
+
+
+def _no_duplicates(pairs):
+    out = {}
+    for k, v in pairs:
+        if k in out:
+            raise NotJson(f"duplicate key {k!r}")
+        out[k] = v
+    return out
+
+
+def _no_constants(name):
+    raise NotJson(f"{name} is not JSON")
+
+
+def parse_ijson(data):
+    """Strict I-JSON (RFC 7493): UTF-8 without BOM, no duplicate keys, numbers as IEEE doubles."""
+    if data.startswith(b"\xef\xbb\xbf"):
+        raise NotJson("byte order mark")
+    try:
+        text = data.decode("utf-8")
+        value = json.loads(text, object_pairs_hook=_no_duplicates, parse_constant=_no_constants,
+                           parse_int=float, parse_float=float)
+    except NotJson:
+        raise
+    except (UnicodeDecodeError, ValueError, RecursionError) as e:
+        raise NotJson(str(e)) from e
+    _check_strings(value)
+    return value
+
+
+def _check_strings(value):
+    """Reject lone surrogates (allowed by \\u escapes in Python's parser, forbidden by I-JSON)."""
+    stack = [value]
+    while stack:
+        v = stack.pop()
+        if isinstance(v, str):
+            try:
+                v.encode("utf-8")
+            except UnicodeEncodeError as e:
+                raise NotJson("lone surrogate") from e
+        elif isinstance(v, list):
+            stack.extend(v)
+        elif isinstance(v, dict):
+            stack.extend(v.keys())
+            stack.extend(v.values())
+        elif isinstance(v, float) and not math.isfinite(v):
+            raise NotJson("number out of double range")
+
+
+def es6_number(x):
+    """ECMAScript Number.prototype.toString for a finite double (what RFC 8785 requires)."""
+    if x == 0:
+        return "0"
+    if x < 0:
+        return "-" + es6_number(-x)
+    sign, digits, exponent = Decimal(repr(x)).as_tuple()  # repr = shortest round-trip digits
+    d = "".join(map(str, digits)).rstrip("0") or "0"
+    k = len(d)
+    n = len(digits) + exponent  # value = 0.d * 10^n
+    if k <= n <= 21:
+        return d + "0" * (n - k)
+    if 0 < n <= 21:
+        return d[:n] + "." + d[n:]
+    if -6 < n <= 0:
+        return "0." + "0" * (-n) + d
+    e = n - 1
+    exp = ("e+" if e >= 0 else "e-") + str(abs(e))
+    return (d if k == 1 else d[0] + "." + d[1:]) + exp
+
+
+def canonical_json(value):
+    if value is None:
+        return "null"
+    if value is True:
+        return "true"
+    if value is False:
+        return "false"
+    if isinstance(value, float):
+        return es6_number(value)
+    if isinstance(value, str):
+        return json.dumps(value, ensure_ascii=False)
+    if isinstance(value, list):
+        return "[" + ",".join(canonical_json(v) for v in value) + "]"
+    if isinstance(value, dict):
+        keys = sorted(value, key=lambda k: k.encode("utf-16-be"))
+        return "{" + ",".join(json.dumps(k, ensure_ascii=False) + ":" + canonical_json(value[k]) for k in keys) + "}"
+    raise NotJson(f"unexpected type {type(value)}")
+
+
+def json_field(data, path):
+    """(code, bytes) for mode jsonField."""
+    try:
+        node = parse_ijson(data)
+    except NotJson:
+        return NOT_JSON, b""
+    for segment in (path.split(".") if path else []):
+        if isinstance(node, dict) and segment in node:
+            node = node[segment]
+        elif (isinstance(node, list) and segment.isdigit() and (segment == "0" or not segment.startswith("0"))
+              and int(segment) < len(node)):
+            node = node[int(segment)]
+        else:
+            return NO_FIELD, b""
+    out = canonical_json(node).encode("utf-8")
+    if len(out) > DATA_CAPACITY:
+        return VALUE_TOO_LARGE, b""
+    return SUCCESS, out
+
+
+# ----------------------------------------------------------------------------- query handling
+
+def code_reply(code):
+    return struct.pack("<Q", code) + bytes(REPLY_SIZE - 8)
+
+
+def parse_query(payload):
+    """Validated query fields, or None if malformed (RESULT_BAD_QUERY)."""
+    (sha256, kind, loc_len, locator, max_size, mode, offset, length, path) = struct.unpack("<32sQQ64sQQQQ64s", payload)
+    if sha256 == bytes(32) or not 1 <= max_size <= MAX_FILE_SIZE or loc_len > 64:
+        return None
+    loc, loc_tail = locator[:loc_len], locator[loc_len:]
+    if loc_tail != bytes(len(loc_tail)):
+        return None
+    if kind == LOCATOR_NONE:
+        if loc_len:
+            return None
+    elif kind == LOCATOR_IPFS:
+        if not CID_RE.fullmatch(loc):
+            return None
+    elif kind == LOCATOR_ARWEAVE:
+        if not ARWEAVE_RE.fullmatch(loc):
+            return None
+    else:
+        return None
+    path_len = path.find(b"\x00")
+    path_len = 64 if path_len < 0 else path_len
+    path_bytes, path_tail = path[:path_len], path[path_len:]
+    if path_tail != bytes(len(path_tail)):
+        return None
+    # fields a mode doesn't use must be zero, so equal requests are equal bytes
+    if mode == MODE_SIZE:
+        if offset or length or path_len:
+            return None
+    elif mode == MODE_RANGE:
+        if path_len or not 1 <= length <= DATA_CAPACITY:
+            return None
+    elif mode == MODE_JSON:
+        if offset or length or not PATH_RE.fullmatch(path_bytes):
+            return None
+        if path_bytes and any(seg == b"" for seg in path_bytes.split(b".")):
+            return None
+    else:
+        return None
+    return {"sha256": sha256, "kind": kind, "locator": loc.decode("ascii"), "max_size": max_size,
+            "mode": mode, "offset": offset, "length": length, "path": path_bytes.decode("ascii")}
+
+
+def handle_query(config, payload):
+    """208B query payload -> (errorFlags, 536B reply payload). Abstains via non-zero flags."""
+    if len(payload) != QUERY_SIZE:
+        return INVALID_ARG, bytes(REPLY_SIZE)
+    q = parse_query(payload)
+    if q is None:
+        return NO_ERROR, code_reply(BAD_QUERY)
+
+    try:
+        data = find_file(config, q["sha256"], q["kind"], q["locator"], q["max_size"])
+    except Exception as e:
+        print(f"[ReadContent] abstain: {e}", file=sys.stderr)
+        return ORACLE_UNAVAIL, bytes(REPLY_SIZE)
+    if data is None:
+        return NO_ERROR, code_reply(NOT_FOUND)
+
+    if q["mode"] == MODE_SIZE:
+        out = b""
+    elif q["mode"] == MODE_RANGE:
+        if q["offset"] + q["length"] > len(data):
+            return NO_ERROR, code_reply(BAD_RANGE)
+        out = data[q["offset"]:q["offset"] + q["length"]]
+    else:
+        code, out = json_field(data, q["path"])
+        if code != SUCCESS:
+            return NO_ERROR, code_reply(code)
+
+    reply = struct.pack("<QQQ", SUCCESS, len(data), len(out)) + out + bytes(DATA_CAPACITY - len(out))
+    assert len(reply) == REPLY_SIZE
+    return NO_ERROR, reply
+
+
+# ----------------------------------------------------------------------------- OM node protocol
+
+def recv_exact(sock, n):
+    buf = b""
+    while len(buf) < n:
+        chunk = sock.recv(n - len(buf))
+        if not chunk:
+            return None
+        buf += chunk
+    return buf
+
+
+class Handler(socketserver.BaseRequestHandler):
+    def setup(self):
+        self.request.settimeout(SOCKET_TIMEOUT_S)
+
+    def handle(self):
+        try:
+            self.serve()
+        except socket.timeout:
+            return  # idle too long; the node reconnects
+
+    def serve(self):
+        while True:
+            header = recv_exact(self.request, 8)
+            if header is None:
+                return
+            size = header[0] | (header[1] << 8) | (header[2] << 16)
+            msg_type = header[3]
+            if size < 8 or size > MAX_FRAME_BYTES:
+                return  # corrupt framing: cannot resync, drop the connection
+            body = recv_exact(self.request, size - 8)
+            if body is None:
+                return
+            if msg_type != OM_QUERY_TYPE or len(body) != 16 + QUERY_SIZE:
+                continue  # skip unrelated frames
+            query_id, interface_index = struct.unpack("<QI", body[:12])
+            if interface_index != INTERFACE_INDEX:
+                continue  # not our interface (misrouted config)
+            try:
+                flags, reply_payload = handle_query(self.server.config, body[16:])
+            except Exception as e:  # structural backstop: never kill the OM connection
+                print(f"[ReadContent] abstain (unexpected): {e}", file=sys.stderr)
+                flags, reply_payload = ORACLE_UNAVAIL, bytes(REPLY_SIZE)
+
+            reply_size = 8 + 16 + REPLY_SIZE
+            packet = bytes([reply_size & 0xFF, (reply_size >> 8) & 0xFF,
+                            (reply_size >> 16) & 0xFF, OM_REPLY_TYPE]) + bytes(4)
+            packet += struct.pack("<QH6x", query_id, flags)
+            packet += reply_payload
+            self.request.sendall(packet)
+
+
+class Server(socketserver.ThreadingTCPServer):
+    allow_reuse_address = True
+    daemon_threads = True
+
+
+def main():
+    args = sys.argv[1:]
+    if args[:1] == ["--log"] and len(args) == 2:
+        log = open(args[1], "a", buffering=1)
+        sys.stdout = sys.stderr = log
+    elif args:
+        print(f"usage: {sys.argv[0]} [--log FILE]")
+        return 0 if args[:1] == ["--help"] else 1
+
+    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
+    urllib.request.install_opener(urllib.request.build_opener(urllib.request.ProxyHandler({})))
+    config = load_config()
+    if not (config["ipfs"] or config["arweave"] or config["mirrors"]):
+        print("No sources configured! Set CONTENT_IPFS_GATEWAYS, CONTENT_ARWEAVE_GATEWAYS or CONTENT_MIRRORS.",
+              file=sys.stderr)
+        return 1
+    port = int(os.environ.get("READ_CONTENT_SERVICE_PORT", "9009"))
+    print(f"[ReadContent] {len(config['ipfs'])} IPFS gateway(s), {len(config['arweave'])} Arweave gateway(s), "
+          f"{len(config['mirrors'])} mirror(s), {config['timeout']:g}s per source")
+    server = Server(("0.0.0.0", port), Handler)
+    server.config = config
+    print(f"[ReadContent] listening on {port}")
+    try:
+        server.serve_forever()
+    except KeyboardInterrupt:
+        pass
+    finally:
+        server.server_close()
+        print("[ReadContent] shutdown")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
