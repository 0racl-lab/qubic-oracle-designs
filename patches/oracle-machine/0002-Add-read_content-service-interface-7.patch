@@ -0,0 +1,55 @@
+#!/usr/bin/env python3
+"""Run one real ContentRead query through the service logic against live gateways.
+
+    CONTENT_IPFS_GATEWAYS=https://ipfs.io,https://dweb.link \
+    python3 test/live_check.py --cid <cid> --sha256 <hex> [--json meta.licence | --range 0 64]
+
+Get the SHA-256 of a file you published with `sha256sum file`. Nothing is sent to Qubic.
+"""
+
+import argparse
+import os
+import struct
+import sys
+import urllib.request
+
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), ".."))
+import read_content_service as svc
+
+NAMES = {0: "SUCCESS", 1: "BAD_QUERY", 2: "NOT_FOUND", 3: "BAD_RANGE", 4: "NOT_JSON", 5: "NO_FIELD",
+         6: "VALUE_TOO_LARGE"}
+
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--sha256", required=True)
+    g = p.add_mutually_exclusive_group()
+    g.add_argument("--cid")
+    g.add_argument("--arweave")
+    p.add_argument("--max-size", type=int, default=1024 * 1024)
+    m = p.add_mutually_exclusive_group()
+    m.add_argument("--json", metavar="PATH")
+    m.add_argument("--range", nargs=2, type=int, metavar=("OFFSET", "LENGTH"))
+    a = p.parse_args()
+    urllib.request.install_opener(urllib.request.build_opener(urllib.request.ProxyHandler({})))
+    kind, loc = (svc.LOCATOR_IPFS, a.cid) if a.cid else (svc.LOCATOR_ARWEAVE, a.arweave) if a.arweave else (svc.LOCATOR_NONE, "")
+    mode, off, length, path = svc.MODE_SIZE, 0, 0, ""
+    if a.json is not None:
+        mode, path = svc.MODE_JSON, a.json
+    elif a.range:
+        mode, (off, length) = svc.MODE_RANGE, a.range
+    payload = struct.pack("<32sQQ64sQQQQ64s", bytes.fromhex(a.sha256), kind, len(loc), loc.encode().ljust(64, b"\0"),
+                          a.max_size, mode, off, length, path.encode().ljust(64, b"\0"))
+    flags, r = svc.handle_query(svc.load_config(), payload)
+    if flags:
+        print(f"abstained (flags {flags:#x}): see the message above")
+        return 2
+    code, size, n = struct.unpack("<QQQ", r[:24])
+    print(f"code {code} {NAMES.get(code, '?')}  fileSize {size}  dataLen {n}")
+    if n:
+        print(r[24:24 + n].decode("utf-8", "replace") if mode == svc.MODE_JSON else r[24:24 + n].hex())
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/oracles/read_content/test/mock_gateway.py b/oracles/read_content/test/mock_gateway.py
new file mode 100755
index 0000000..1b06ad7
--- /dev/null
+++ b/oracles/read_content/test/mock_gateway.py
@@ -0,0 +1,86 @@
+#!/usr/bin/env python3
+"""Minimal mock IPFS / Arweave gateway and content mirror for the read_content oracle service selftest.
+
+Serves  GET /ipfs/<cid>      (IPFS gateway style)
+        GET /<arweave-id>    (Arweave gateway style)
+        GET /sha256/<hex>    (content mirror style)
+
+--tamper  serves different bytes for the licence document (a lying gateway)
+--broken  answers HTTP 502 for everything (a failing gateway)
+
+Usage: mock_gateway.py --port 18845 [--tamper | --broken]
+"""
+
+import argparse
+import hashlib
+import json
+from http.server import BaseHTTPRequestHandler, HTTPServer
+
+LICENCE_DOC = json.dumps({
+    "name": "Qubic weather dataset",
+    "meta": {"licence": "CC-BY-4.0", "version": 3, "contributors": ["alice", "bob"]},
+    "items": [{"id": 1, "temp": 12.5}, {"id": 2, "temp": -0.25}],
+    "big": "x" * 600,
+}, indent=2).encode()
+PLAIN = bytes(range(256)) * 8  # 2048 bytes
+NOT_JSON = b"\xef\xbb\xbf{\"bom\": true}"
+DUP_KEYS = b'{"a": 1, "a": 2}'
+LARGE = b"L" * (3 * 1024 * 1024)  # 3 MiB
+
+CID_LICENCE = "bafkreilicencedoc000000000000000000000000000000000000000"
+CID_PLAIN = "QmPlainBinaryFile1111111111111111111111111111"
+CID_LARGE = "bafkreilargefile00000000000000000000000000000000000000000"
+CID_BOM = "bafkreibomfile0000000000000000000000000000000000000000000"
+CID_DUP = "bafkreiduplicatekeys000000000000000000000000000000000000"
+AR_PLAIN = "abcdefghijklmnopqrstuvwxyz0123456789_-ABCDE"  # 43 base64url chars
+
+BY_CID = {CID_LICENCE: LICENCE_DOC, CID_PLAIN: PLAIN, CID_LARGE: LARGE, CID_BOM: NOT_JSON, CID_DUP: DUP_KEYS}
+BY_ARWEAVE = {AR_PLAIN: PLAIN}
+BY_SHA = {hashlib.sha256(b).hexdigest(): b for b in (LICENCE_DOC, PLAIN)}
+
+
+class Handler(BaseHTTPRequestHandler):
+    mode = ""
+
+    def log_message(self, fmt, *args):  # quiet
+        pass
+
+    def send(self, status, body=b""):
+        self.send_response(status)
+        self.send_header("Content-Length", str(len(body)))
+        self.end_headers()
+        try:
+            self.wfile.write(body)
+        except (BrokenPipeError, ConnectionResetError):
+            pass  # the service stopped reading at maxFileSize, as it should
+
+    def do_GET(self):
+        if self.mode == "broken":
+            return self.send(502, b"bad gateway")
+        path = self.path
+        body = None
+        if path.startswith("/ipfs/"):
+            body = BY_CID.get(path[6:])
+            if body is LICENCE_DOC and self.mode == "tamper":
+                body = LICENCE_DOC.replace(b"CC-BY-4.0", b"CC0-1.0!!")
+        elif path.startswith("/sha256/"):
+            body = BY_SHA.get(path[8:])
+        else:
+            body = BY_ARWEAVE.get(path[1:])
+        if body is None:
+            return self.send(404, b"not found")
+        self.send(200, body)
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--port", type=int, required=True)
+    parser.add_argument("--tamper", action="store_true")
+    parser.add_argument("--broken", action="store_true")
+    args = parser.parse_args()
+    Handler.mode = "tamper" if args.tamper else "broken" if args.broken else ""
+    HTTPServer(("127.0.0.1", args.port), Handler).serve_forever()
+
+
+if __name__ == "__main__":
+    main()
