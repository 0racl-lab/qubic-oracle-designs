@@ -0,0 +1,192 @@
+#!/usr/bin/env python3
+"""Selftest for read_content_service.py against mock_gateway.py. Run:
+    python3 test/mock_gateway.py --port 18845 &
+    python3 test/mock_gateway.py --port 18846 --tamper &
+    python3 test/mock_gateway.py --port 18847 --broken &
+    python3 test/selftest.py           (exit 0 = all pass)
+"""
+
+import hashlib
+import os
+import socket
+import struct
+import sys
+import threading
+import urllib.request
+
+HERE = os.path.dirname(__file__)
+sys.path.insert(0, os.path.join(HERE, ".."))
+sys.path.insert(0, HERE)
+urllib.request.install_opener(urllib.request.build_opener(urllib.request.ProxyHandler({})))
+
+import read_content_service as svc
+import mock_gateway as gw
+
+GOOD, TAMPER, BROKEN = "http://127.0.0.1:18845", "http://127.0.0.1:18846", "http://127.0.0.1:18847"
+SHA_DOC = hashlib.sha256(gw.LICENCE_DOC).digest()
+SHA_PLAIN = hashlib.sha256(gw.PLAIN).digest()
+SHA_LARGE = hashlib.sha256(gw.LARGE).digest()
+SHA_BOM = hashlib.sha256(gw.NOT_JSON).digest()
+SHA_DUP = hashlib.sha256(gw.DUP_KEYS).digest()
+MIB = 1024 * 1024
+
+failures = 0
+
+
+def check(cond, what):
+    global failures
+    print(f"  [{'PASS' if cond else 'FAIL'}] {what}")
+    if not cond:
+        failures += 1
+
+
+def query(sha, kind=svc.LOCATOR_IPFS, locator="", max_size=MIB, mode=svc.MODE_SIZE, offset=0, length=0, path="",
+          locator_len=None, raw_path=None):
+    loc = locator.encode()
+    n = len(loc) if locator_len is None else locator_len
+    p = raw_path if raw_path is not None else path.encode()
+    return struct.pack("<32sQQ64sQQQQ64s", sha, kind, n, loc.ljust(64, b"\0"), max_size, mode, offset, length,
+                       p.ljust(64, b"\0"))
+
+
+def configure(ipfs=(), arweave=(), mirrors=()):
+    os.environ["CONTENT_IPFS_GATEWAYS"] = ",".join(ipfs)
+    os.environ["CONTENT_ARWEAVE_GATEWAYS"] = ",".join(arweave)
+    os.environ["CONTENT_MIRRORS"] = ",".join(mirrors)
+    os.environ["CONTENT_FETCH_TIMEOUT_S"] = "5"
+    return svc.load_config()
+
+
+def u64(r, i):
+    return struct.unpack("<Q", r[i:i + 8])[0]
+
+
+def data(r):
+    return r[24:24 + u64(r, 16)]
+
+
+def main():
+    cfg = configure(ipfs=[GOOD])
+
+    print("SUCCESS (verified by SHA-256):")
+    flags, r = svc.handle_query(cfg, query(SHA_PLAIN, locator=gw.CID_PLAIN))
+    check(flags == svc.NO_ERROR and len(r) == 536, "service answers, reply is 536 bytes")
+    check(u64(r, 0) == svc.SUCCESS and u64(r, 8) == 2048 and u64(r, 16) == 0 and r[24:] == bytes(512),
+          "size mode: fileSize 2048, no data")
+    flags, r = svc.handle_query(cfg, query(SHA_PLAIN, locator=gw.CID_PLAIN, mode=svc.MODE_RANGE, offset=250, length=10))
+    check(u64(r, 0) == svc.SUCCESS and data(r) == bytes([250, 251, 252, 253, 254, 255, 0, 1, 2, 3]),
+          "byte range 250..259 byte-exact")
+    flags, r = svc.handle_query(cfg, query(SHA_PLAIN, locator=gw.CID_PLAIN, mode=svc.MODE_RANGE, offset=1536, length=512))
+    check(u64(r, 0) == svc.SUCCESS and data(r) == gw.PLAIN[1536:], "last 512 bytes (full-width range)")
+    flags, r = svc.handle_query(cfg, query(SHA_DOC, locator=gw.CID_LICENCE, mode=svc.MODE_JSON, path="meta.licence"))
+    check(u64(r, 0) == svc.SUCCESS and data(r) == b'"CC-BY-4.0"', 'JSON field meta.licence -> "CC-BY-4.0"')
+    flags, r = svc.handle_query(cfg, query(SHA_DOC, locator=gw.CID_LICENCE, mode=svc.MODE_JSON, path="meta"))
+    check(data(r) == b'{"contributors":["alice","bob"],"licence":"CC-BY-4.0","version":3}',
+          "JSON object in RFC 8785 canonical form (sorted keys, no spaces, 3 not 3.0)")
+    flags, r = svc.handle_query(cfg, query(SHA_DOC, locator=gw.CID_LICENCE, mode=svc.MODE_JSON, path="items.1.temp"))
+    check(data(r) == b"-0.25", "array index path items.1.temp -> -0.25")
+
+    print("Sources:")
+    flags, r = svc.handle_query(configure(arweave=[GOOD]), query(SHA_PLAIN, kind=svc.LOCATOR_ARWEAVE, locator=gw.AR_PLAIN))
+    check(u64(r, 0) == svc.SUCCESS and u64(r, 8) == 2048, "Arweave gateway by transaction id")
+    flags, r = svc.handle_query(configure(mirrors=[GOOD + "/sha256/{sha256}"]), query(SHA_DOC, kind=svc.LOCATOR_NONE))
+    check(u64(r, 0) == svc.SUCCESS and u64(r, 8) == len(gw.LICENCE_DOC), "no locator: found on a mirror by hash")
+    cfg2 = configure(ipfs=[TAMPER, GOOD])
+    flags, r = svc.handle_query(cfg2, query(SHA_DOC, locator=gw.CID_LICENCE, mode=svc.MODE_JSON, path="meta.licence"))
+    check(u64(r, 0) == svc.SUCCESS and data(r) == b'"CC-BY-4.0"',
+          "lying gateway first: its bytes fail the hash, the honest copy is used")
+    flags, r = svc.handle_query(configure(ipfs=[GOOD, BROKEN]), query(SHA_PLAIN, locator=gw.CID_PLAIN))
+    check(u64(r, 0) == svc.SUCCESS, "a broken gateway after a verified copy doesn't matter")
+
+    print("Result codes:")
+    flags, r = svc.handle_query(cfg, query(SHA_PLAIN, locator="bafkreimissing"))
+    check(flags == svc.NO_ERROR and u64(r, 0) == svc.NOT_FOUND and r[8:] == bytes(528),
+          "every source says 404: NOT_FOUND, rest zero")
+    flags, r = svc.handle_query(configure(ipfs=[TAMPER]), query(SHA_DOC, locator=gw.CID_LICENCE))
+    check(u64(r, 0) == svc.NOT_FOUND, "only wrong bytes available: NOT_FOUND (never the wrong file)")
+    flags, r = svc.handle_query(cfg, query(SHA_LARGE, locator=gw.CID_LARGE, max_size=2 * MIB))
+    check(u64(r, 0) == svc.NOT_FOUND, "3 MiB file with maxFileSize 2 MiB: NOT_FOUND (can't be verified)")
+    flags, r = svc.handle_query(cfg, query(SHA_LARGE, locator=gw.CID_LARGE, max_size=3 * MIB))
+    check(u64(r, 0) == svc.SUCCESS and u64(r, 8) == 3 * MIB, "same file with maxFileSize 3 MiB: SUCCESS")
+    flags, r = svc.handle_query(cfg, query(SHA_PLAIN, locator=gw.CID_PLAIN, mode=svc.MODE_RANGE, offset=2040, length=9))
+    check(u64(r, 0) == svc.BAD_RANGE, "range past the end: BAD_RANGE")
+    flags, r = svc.handle_query(cfg, query(SHA_PLAIN, locator=gw.CID_PLAIN, mode=svc.MODE_JSON, path="a"))
+    check(u64(r, 0) == svc.NOT_JSON, "binary file in JSON mode: NOT_JSON")
+    flags, r = svc.handle_query(cfg, query(SHA_BOM, locator=gw.CID_BOM, mode=svc.MODE_JSON))
+    check(u64(r, 0) == svc.NOT_JSON, "JSON with a byte order mark: NOT_JSON")
+    flags, r = svc.handle_query(cfg, query(SHA_DUP, locator=gw.CID_DUP, mode=svc.MODE_JSON))
+    check(u64(r, 0) == svc.NOT_JSON, "duplicate keys (not I-JSON): NOT_JSON")
+    flags, r = svc.handle_query(cfg, query(SHA_DOC, locator=gw.CID_LICENCE, mode=svc.MODE_JSON, path="meta.missing"))
+    check(u64(r, 0) == svc.NO_FIELD, "missing key: NO_FIELD")
+    flags, r = svc.handle_query(cfg, query(SHA_DOC, locator=gw.CID_LICENCE, mode=svc.MODE_JSON, path="items.01"))
